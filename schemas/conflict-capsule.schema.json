{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wharness.local/schemas/conflict-capsule.schema.json",
  "title": "Wharness Conflict Capsule v1",
  "description": "Three versions of every conflicting file plus the intent behind each side. `origin` says which reconciliation is being asked for: the historical case is a Wharnex candidate colliding with the host, and a Git-origin capsule additionally carries the merge to replay.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "conflict_id", "current_revision", "original_plan_ids", "files"],
  "properties": {
    "protocol": {"const": "harness.conflict/v1"},
    "conflict_id": {"type": "string", "minLength": 1},
    "current_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "original_plan_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "origin": {
      "description": "What produced the conflict. Absent means `integration`, the historical case.",
      "enum": ["integration", "push", "branch_merge"]
    },
    "git": {
      "description": "Present for a host Git operation the operator started. The resolution is replayed into this exact merge and committed as its merge commit, never turned into a new verified candidate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "base_sha", "ours_sha", "theirs_sha"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "target_branch": {"type": "string"},
        "remote": {"type": "string"},
        "base_sha": {"type": "string"},
        "ours_sha": {"type": "string"},
        "theirs_sha": {"type": "string"}
      }
    },
    "intent": {
      "description": "Why each side exists. Three versions of a file say what differs; only intent says which reconciliation is correct.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "our_goal": {"type": "string"},
        "our_commit_message": {"type": "string"},
        "incoming_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["commit", "purpose"],
            "properties": {
              "commit": {"type": "string"},
              "purpose": {"type": "string"}
            }
          }
        },
        "attempt": {"type": "integer", "minimum": 0},
        "max_attempts": {"type": "integer", "minimum": 0},
        "previous_attempts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason", "base_exists", "current_exists", "result_exists", "base_sha256", "current_sha256", "result_sha256", "base", "current", "result"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "base_exists": {"type": "boolean"},
          "current_exists": {"type": "boolean"},
          "result_exists": {"type": "boolean"},
          "base_sha256": {"type": "string"},
          "current_sha256": {"type": "string"},
          "result_sha256": {"type": "string"},
          "base": {"type": "string"},
          "current": {"type": "string"},
          "result": {"type": "string"}
        }
      }
    }
  }
}
