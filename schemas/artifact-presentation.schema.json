{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wharness.local/schemas/artifact-presentation.schema.json",
  "title": "Wharnex Artifact Presentation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "galleries"],
  "properties": {
    "protocol": { "const": "harness.artifact-presentation/v1" },
    "galleries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/gallery" }
    }
  },
  "$defs": {
    "gallery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "items"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "maxLength": 240 },
        "description": { "type": "string", "maxLength": 1200 },
        "layout": { "enum": ["auto", "grid", "masonry", "strip"] },
        "sizing": { "enum": ["uniform", "adaptive"] },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^artifacts/[^\\u0000]+$" },
        "preview_path": { "type": "string", "pattern": "^artifacts/[^\\u0000]+$" },
        "label": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1200 },
        "alt": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
