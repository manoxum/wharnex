{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wharness.local/schemas/orchestrator-plan.schema.json",
  "title": "Wharnex Orchestrator Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "title", "objective", "assumptions", "tasks"],
  "properties": {
    "protocol": { "const": "harness.orchestrator-plan/v1" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 128
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 256
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "description", "acceptance_criteria", "depends_on",
        "priority", "capability", "complexity", "parallelizable",
        "impact_files", "read_files", "barrier_files"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "acceptance_criteria": { "$ref": "#/$defs/stringList" },
        "depends_on": { "$ref": "#/$defs/stringList" },
        "priority": { "enum": ["low", "normal", "high", "urgent"] },
        "capability": { "type": "string" },
        "complexity": { "enum": ["low", "medium", "high"] },
        "parallelizable": { "type": "boolean" },
        "impact_files": { "$ref": "#/$defs/stringList" },
        "read_files": { "$ref": "#/$defs/stringList" },
        "barrier_files": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
