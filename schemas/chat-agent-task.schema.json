{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wharnex.local/schemas/chat-agent-task.schema.json",
  "title": "Wharnex durable ChatGPT browser-agent task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "type", "project_id", "chat_id", "session_id", "request_id", "root_request_id", "conversation_id", "parent_task_id", "priority", "status", "not_before", "attempt", "max_attempts", "dedupe_key", "lease_owner", "payload", "last_error", "created_at", "updated_at"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "type": {"enum": ["TRANSLATE_MARKDOWN", "ORCHESTRATOR_PLAN", "BOT_WRITE", "RECOVERY_WRITE", "AWAIT_RESPONSE", "TITLE_DISCOVER", "TITLE_GENERATE_TEMP", "TITLE_AWAIT", "ORGANIZE_CHAT", "RENAME_CHAT", "ARCHIVE_CHAT", "DELETE_CHAT", "DELETE_BUNDLE", "DELETE_TEMP_CHAT"]},
    "project_id": {"type": "string", "maxLength": 4096},
    "chat_id": {"type": "string", "maxLength": 256},
    "session_id": {"type": "string", "maxLength": 256},
    "request_id": {"type": "string", "maxLength": 256},
    "root_request_id": {"type": "string", "maxLength": 256},
    "conversation_id": {"type": "string", "maxLength": 128},
    "parent_task_id": {"type": "string", "maxLength": 128},
    "priority": {"type": "integer", "minimum": -1, "maximum": 4},
    "status": {"enum": ["PENDING", "LEASED", "RUNNING", "WAITING", "DONE", "FAILED", "ATTENTION", "CANCELLED"]},
    "not_before": {"type": "string", "format": "date-time"},
    "attempt": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 30},
    "dedupe_key": {"type": "string", "maxLength": 512},
    "lease_owner": {"type": "string", "maxLength": 256},
    "lease_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "payload": {"type": "object"},
    "last_error": {"type": "string", "maxLength": 4096},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "anyOf": [
    {"required": ["chat_id"], "properties": {"chat_id": {"minLength": 1}}},
    {"required": ["conversation_id"], "properties": {"conversation_id": {"minLength": 1}}}
  ]
}
