{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernl.local/schemas/execution-plan.schema.json",
  "title": "Wharness Execution Plan v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "base_context_sha256",
    "impact_files",
    "plan_id",
    "request_id",
    "status",
    "summary",
    "risk",
    "requires_approval",
    "operations",
    "verification"
  ],
  "properties": {
    "protocol": {
      "enum": [
        "harness.execution/v1",
        "harness.execution/v2"
      ]
    },
    "base_context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "impact_files": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "read_files": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "barrier_files": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "description": "Short human-facing description of what this bundle actually did, mandatory on every plan-bearing response and validated at ingestion. Wharnex shows it in the chat transcript and in the self-evolution activation dialog, where it is the only prose explaining what a restart would activate. State the concrete implemented, corrected or investigated outcome; placeholders such as 'short summary', 'changes' or 'done' are rejected."
    },
    "document": {
      "type": "string",
      "maxLength": 262144,
      "description": "Human-facing Markdown execution contract: outcome, approach, risks, rollback considerations and verification."
    },
    "dependencies": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "manager",
          "name",
          "action",
          "reason"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "manager": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string"
          },
          "action": {
            "enum": [
              "install",
              "update",
              "remove",
              "use"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "system_tools": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "name",
          "action",
          "reason"
        ],
        "properties": {
          "target": {
            "enum": [
              "sandbox",
              "host"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "install",
              "update",
              "configure",
              "use"
            ]
          },
          "lifetime": {
            "enum": [
              "temporary",
              "persistent"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "approved_chat_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "request_id",
        "sha256",
        "document"
      ],
      "properties": {
        "protocol": {
          "const": "harness.chat-plan/v1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "document": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        }
      },
      "description": "Exact planning-only proposal previously approved by the operator. Required on its linked implementation continuation and verified byte-for-byte by Wharnex."
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "target",
        "rationale"
      ],
      "properties": {
        "protocol": {
          "enum": [
            "harness.debug/v1",
            "harness.interactive/v1",
            "harness.interactive/v2"
          ]
        },
        "target": {
          "enum": [
            "sandbox",
            "host"
          ]
        },
        "access": {
          "enum": [
            "observe",
            "modify"
          ]
        },
        "query": {
          "enum": [
            "project_execution_summary"
          ]
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "command",
              "shell",
              "sql",
              "logs",
              "filesystem",
              "process",
              "network",
              "container",
              "service"
            ]
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "connections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "log_sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "processes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "services": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "containers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "network_destinations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "description": "Interactive v1 remains strict read-only compatibility. Interactive v2 uses explicit capabilities, target scope and access; host/sensitive or modifying operations are approval-gated by Policy."
    },
    "version_increment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "amount"
      ],
      "properties": {
        "component": {
          "enum": [
            "major",
            "medium",
            "minor",
            "patch"
          ],
          "description": "Four-part vA.B.C.D component: major=A, medium=B, minor=C, patch=D."
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "description": "Required for change plans and forbidden for workflow plans. Wharnex applies it to engine-owned root VERSION only after successful host integration; planners never patch VERSION directly."
    },
    "commit_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Planner-authored Git commit message for change plans, mandatory and validated before execution. The first line is a Conventional Commits subject of at most 72 characters that classifies the dominant change and states the concrete implemented or corrected technical outcome; bookkeeping subjects such as 'update files' or 'apply patch' are rejected. An optional body, separated by exactly one blank line, explains why the change was made and is preserved verbatim in the real commit. Workflow plans omit the field."
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "requires_approval": {
      "type": "boolean"
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "cross_project": {
      "type": "array",
      "maxItems": 8,
      "description": "Changes for projects other than the one this request belongs to. Admissible only for a project this request's own main prompt granted with @ref:<project>; an entry naming anything else is refused at ingestion, before Policy and before any sandbox. One self-contained entry per project: each is executed as a derived request on that project, with that project's own Protected sandbox, verification and Git-native host integration. See adr/ADR-0053.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "commit_message",
          "operations"
        ],
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$",
            "description": "The granted reference name exactly as the prompt's @ref: directive wrote it — a project name, never a filesystem path. Wharnex resolves it against the grant it recorded before the request was planned."
          },
          "commit_message": {
            "type": "string",
            "minLength": 1,
            "description": "This change's own Git message for that project, under the same Conventional Commits contract as the primary plan's commit_message. It becomes that project's permanent history."
          },
          "summary": {
            "type": "string",
            "maxLength": 600,
            "description": "Optional short description of this project's part of the change. Falls back to the commit message subject."
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/operation"
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/command"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "timeout_seconds",
        "network",
        "expected_exit_codes"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "network": {
          "type": "boolean"
        },
        "expected_exit_codes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Concise user-facing explanation of why this command is needed and what evidence or effect it should produce; never private chain-of-thought."
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "apply_patch",
            "command",
            "shell",
            "sql",
            "logs",
            "filesystem",
            "process",
            "network",
            "container",
            "service"
          ]
        },
        "patch": {
          "type": "string"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "shell": {
          "$ref": "#/$defs/interactiveShell"
        },
        "sql": {
          "$ref": "#/$defs/interactiveSQL"
        },
        "logs": {
          "$ref": "#/$defs/interactiveLogs"
        },
        "filesystem": {
          "$ref": "#/$defs/interactiveFilesystem"
        },
        "process": {
          "$ref": "#/$defs/interactiveProcess"
        },
        "network": {
          "$ref": "#/$defs/interactiveNetwork"
        },
        "container": {
          "$ref": "#/$defs/interactiveContainer"
        },
        "service": {
          "$ref": "#/$defs/interactiveService"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Concise operator-facing purpose for this typed operation. Interactive v2 planners should provide it for every operation."
        }
      }
    },
    "interactiveShell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "shell",
        "cwd",
        "timeout_seconds",
        "network"
      ],
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "shell": {
          "const": "bash"
        },
        "cwd": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "network": {
          "type": "boolean"
        },
        "env_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "interactiveSQL": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "statement",
        "mode",
        "timeout_seconds",
        "max_rows"
      ],
      "properties": {
        "connection_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "mode": {
          "enum": [
            "read_only",
            "write"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      }
    },
    "interactiveLogs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "limit"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "container": {
          "type": "string"
        },
        "since": {
          "type": "string"
        },
        "until": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "filter": {
          "type": "string"
        }
      }
    },
    "interactiveFilesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "path"
      ],
      "properties": {
        "action": {
          "enum": [
            "list",
            "stat",
            "read",
            "write",
            "remove",
            "rename"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        }
      }
    },
    "interactiveProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "list",
            "signal"
          ]
        },
        "pid": {
          "type": "integer",
          "minimum": 2
        },
        "signal": {
          "type": "string"
        }
      }
    },
    "interactiveNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "address",
        "timeout_seconds"
      ],
      "properties": {
        "action": {
          "const": "connect"
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "interactiveContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "name"
      ],
      "properties": {
        "action": {
          "enum": [
            "inspect",
            "logs",
            "restart",
            "exec"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tail": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800
        }
      }
    },
    "interactiveService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "name"
      ],
      "properties": {
        "action": {
          "enum": [
            "status",
            "restart"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
