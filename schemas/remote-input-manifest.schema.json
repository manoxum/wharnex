{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wharness.local/schemas/remote-input-manifest.schema.json",
  "title": "Wharness remote input transport manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "prompt",
    "context_included",
    "context_roots",
    "project_files",
    "knowledge"
  ],
  "properties": {
    "protocol": {
      "const": "wharness.remote-input/v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "prompt": {
      "const": "prompt/wharness-planner-prompt.md"
    },
    "context_included": {
      "type": "boolean"
    },
    "context_mode": { "enum": ["full", "partial"] },
    "context_paths": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(context|ref-context|att-context)/" }
    },
    "project_files": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "path",
        "version",
        "sha256",
        "updated_by_request_id"
      ],
      "properties": {
        "state": {
          "enum": [
            "none",
            "present"
          ]
        },
        "path": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        },
        "updated_by_request_id": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "present"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "const": "knowledge/project.md"
              },
              "version": {
                "minimum": 1
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "const": ""
              },
              "version": {
                "const": 0
              },
              "sha256": {
                "const": ""
              },
              "updated_by_request_id": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "context_roots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "references",
        "attached_paths",
        "sources_index"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "enum": [
            "",
            "context/"
          ]
        },
        "references": {
          "type": "string",
          "enum": [
            "",
            "ref-context/"
          ]
        },
        "attached_paths": {
          "type": "string",
          "enum": [
            "",
            "att-context/"
          ]
        },
        "sources_index": {
          "type": "string",
          "enum": [
            "",
            "metadata/context-sources.json"
          ]
        }
      }
    }
  }
}
