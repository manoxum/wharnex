{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wharness.local/schemas/agent-turn.schema.json",
  "title": "Wharness Agent Turn v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "kind",
    "message",
    "outcome"
  ],
  "properties": {
    "protocol": {
      "const": "harness.turn/v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "answer",
        "clarification",
        "investigation",
        "plan",
        "workflow",
        "change",
        "blocked"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    },
    "resolved_evidence_ids": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^evt_" }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "retryable"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "failed", "partial"]
        },
        "reason_code": {
          "type": "string",
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "maxLength": 16384
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["failed", "partial"] } } },
          "then": {
            "required": ["message"],
            "properties": { "message": { "minLength": 1 } }
          }
        }
      ]
    }
  }
}
