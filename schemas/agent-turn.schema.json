{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wharness.local/schemas/agent-turn.schema.json",
  "title": "Wharness Agent Turn v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "kind",
    "message",
    "outcome"
  ],
  "properties": {
    "protocol": {
      "const": "harness.turn/v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "answer",
        "clarification",
        "investigation",
        "plan",
        "workflow",
        "context_request",
        "change",
        "blocked"
      ]
    },
    "chat_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 82
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    },
    "context_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(context|ref-context|att-context)/[^/].*" }
    },
    "resolved_evidence_ids": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^evt_" }
    },
    "interview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "questions"],
      "properties": {
        "protocol": { "const": "harness.interview/v1" },
        "questions": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "prompt", "options"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
              "prompt": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "allow_multiple": { "type": "boolean" },
              "options": {
                "type": "array", "minItems": 2, "maxItems": 8,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["id", "label"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
                    "label": { "type": "string", "minLength": 1, "maxLength": 512 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "retryable"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "failed", "partial"]
        },
        "reason_code": {
          "type": "string",
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "maxLength": 16384
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["failed", "partial"] } } },
          "then": {
            "required": ["message"],
            "properties": { "message": { "minLength": 1 } }
          }
        }
      ]
    }
  }
}
