{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wharness.local/schemas/language-settings.schema.json",
  "title": "Wharnex global language settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "interface_language", "translation_languages"],
  "properties": {
    "version": {"const": 1},
    "interface_language": {"enum": ["pt", "en", "fr"]},
    "translation_languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["pt", "en", "fr"]}
    }
  }
}
