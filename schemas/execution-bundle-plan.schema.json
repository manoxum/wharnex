{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wharness.local/schemas/execution-bundle-plan.schema.json",
  "type": "object",
  "required": ["protocol", "base_context_sha256", "impact_files", "plan_id", "request_id", "status", "summary", "risk", "requires_approval", "operations", "verification"],
  "properties": {
    "protocol": {"enum": ["harness.execution/v1", "harness.execution/v2"]},
    "base_context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "impact_files": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1}},
    "read_files": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1}},
    "barrier_files": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}},
    "plan_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "blocked"]},
    "summary": {"type": "string"},
    "document": {"type": "string", "maxLength": 262144},
    "dependencies": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scope", "manager", "name", "action", "reason"],
        "properties": {
          "scope": {"type": "string", "minLength": 1},
          "manager": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string"},
          "action": {"enum": ["install", "update", "remove", "use"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "system_tools": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target", "name", "action", "reason"],
        "properties": {
          "target": {"enum": ["sandbox", "host"]},
          "name": {"type": "string", "minLength": 1},
          "action": {"enum": ["install", "update", "configure", "use"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "approved_chat_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "request_id", "sha256", "document"],
      "properties": {
        "protocol": {"const": "harness.chat-plan/v1"},
        "request_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "document": {"type": "string", "minLength": 1, "maxLength": 262144}
      }
    },
    "debug": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "target", "rationale"],
      "properties": {
		"protocol": {"enum": ["harness.debug/v1", "harness.interactive/v1"]},
		"access": {"enum": ["observe"]},
        "target": {"enum": ["sandbox", "host"]},
		"query": {"enum": ["project_execution_summary"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "risk": {"enum": ["low", "medium", "high"]},
    "requires_approval": {"type": "boolean"},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "command"],
        "properties": {
          "type": {"enum": ["apply_patch", "command"]},
          "patch": {"type": "string"},
          "patch_file": {"type": "string", "pattern": "^patches/[^/]+\\.patch$"},
          "command": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "verification": {"type": "array"}
  },
  "additionalProperties": false
}
