HARNESS_ADDR=127.0.0.1:8080
HARNESS_PLANNER=manual
HARNESS_SANDBOX=docker
HARNESS_RUNNER_IMAGE=kernl-runner:local
HARNESS_MAX_CONTEXT_BYTES=4194304
HARNESS_MAX_BUNDLE_BYTES=134217728
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
HARNESS_ALLOW_LOCAL_SANDBOX=false
# Optional visual label baked into the Desktop frontend for this checkout.
WHARNESS_INSTANCE_ID=
# How many Agent plans one project may verify at the same time (default 1, max 8).
# Also adjustable at runtime from the workspace FIFO queue view. Each concurrent
# runner claims a full container memory allowance plus a complete project clone,
# so raise it only on a machine with the disk and RAM headroom to match.
WHARNESS_PROJECT_EXECUTION_CONCURRENCY=1
