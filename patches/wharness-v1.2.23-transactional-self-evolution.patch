+package selfevolution
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestManagerDetectsOnlyExactCanonicalRoot(t *testing.T) {
+	root := fakeRoot(t)
+	manager := New(root)
+	if !manager.IsProject(root) {
+		t.Fatal("expected exact root to be self-evolution")
+	}
+	if manager.IsProject(filepath.Join(root, "services", "backend")) {
+		t.Fatal("subdirectory must not be treated as self-evolution root")
+	}
+	link := filepath.Join(t.TempDir(), "wharness-link")
+	if err := os.Symlink(root, link); err != nil {
+		t.Fatal(err)
+	}
+	if !manager.IsProject(link) {
+		t.Fatal("canonical symlink to the same root should be detected")
+	}
+}
+
+func TestTransactionRollbackRestoresTouchedSourceAndRuntime(t *testing.T) {
+	root := fakeRoot(t)
+	mustWrite(t, filepath.Join(root, "hello.txt"), "before\n", 0o644)
+	mustWrite(t, filepath.Join(root, "dist", "bin", "wharness-backend"), "old-backend\n", 0o755)
+	mustWrite(t, filepath.Join(root, "services", "frontend", "dist", "index.html"), "old-frontend\n", 0o644)
+	mustWrite(t, filepath.Join(root, ".harness", "build-success"), "", 0o600)
+
+	patch := strings.Join([]string{
+		"diff --git a/hello.txt b/hello.txt",
+		"--- a/hello.txt",
+		"+++ b/hello.txt",
+		"@@ -1 +1 @@",
+		"-before",
+		"+after",
+		"diff --git a/new.txt b/new.txt",
+		"--- /dev/null",
+		"+++ b/new.txt",
+		"@@ -0,0 +1 @@",
+		"+new",
+	}, "\n")
+
+	manager := New(root)
+	tx, err := manager.Prepare("plan-test", []string{patch})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Release()
+
+	mustWrite(t, filepath.Join(root, "hello.txt"), "after\n", 0o644)
+	mustWrite(t, filepath.Join(root, "new.txt"), "new\n", 0o644)
+	mustWrite(t, filepath.Join(root, "dist", "bin", "wharness-backend"), "new-backend\n", 0o755)
+	mustWrite(t, filepath.Join(root, "services", "frontend", "dist", "index.html"), "new-frontend\n", 0o644)
+	_ = os.Remove(filepath.Join(root, ".harness", "build-success"))
+
+	if err := tx.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	assertFile(t, filepath.Join(root, "hello.txt"), "before\n")
+	if _, err := os.Stat(filepath.Join(root, "new.txt")); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("new file should be removed, got %v", err)
+	}
+	assertFile(t, filepath.Join(root, "dist", "bin", "wharness-backend"), "old-backend\n")
+	assertFile(t, filepath.Join(root, "services", "frontend", "dist", "index.html"), "old-frontend\n")
+	if _, err := os.Stat(filepath.Join(root, ".harness", "build-success")); err != nil {
+		t.Fatalf("build stamp should be restored: %v", err)
+	}
+}
+
+func TestTransactionLockRejectsConcurrentSelfEvolution(t *testing.T) {
+	root := fakeRoot(t)
+	mustWrite(t, filepath.Join(root, "hello.txt"), "before\n", 0o644)
+	patch := "--- a/hello.txt\n+++ b/hello.txt\n@@ -1 +1 @@\n-before\n+after\n"
+	manager := New(root)
+	first, err := manager.Prepare("plan-one", []string{patch})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer first.Release()
+	if _, err := manager.Prepare("plan-two", []string{patch}); !errors.Is(err, ErrBusy) {
+		t.Fatalf("expected ErrBusy, got %v", err)
+	}
+}
+
+func fakeRoot(t *testing.T) string {
+	t.Helper()
+	root := t.TempDir()
+	mustWrite(t, filepath.Join(root, "Makefile"), "all:\n\t@true\n", 0o644)
+	mustWrite(t, filepath.Join(root, "services", "backend", "go.mod"), "module example.invalid/fake\n", 0o644)
+	mustWrite(t, filepath.Join(root, "services", "desktop", "package.json"), "{}\n", 0o644)
+	mustWrite(t, filepath.Join(root, "scripts", "self-restart.sh"), "#!/usr/bin/env sh\nexit 0\n", 0o755)
+	mustWrite(t, filepath.Join(root, "scripts", "start.sh"), "#!/usr/bin/env sh\nexit 0\n", 0o755)
+	mustWrite(t, filepath.Join(root, "scripts", "stop.sh"), "#!/usr/bin/env sh\nexit 0\n", 0o755)
+	return root
+}
+
+func mustWrite(t *testing.T, path, content string, mode os.FileMode) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), mode); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func assertFile(t *testing.T, path, expected string) {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(data) != expected {
+		t.Fatalf("%s = %q, expected %q", path, string(data), expected)
+	}
+}
+
+func TestBuildHostRejectsDependencyMetadataMutation(t *testing.T) {
+	root := fakeRoot(t)
+	mustWrite(t, filepath.Join(root, "hello.txt"), "before\n", 0o644)
+	mustWrite(t, filepath.Join(root, "Makefile"), "build:\n\t@mkdir -p services/frontend\n\t@printf 'unexpected\\n' > services/frontend/package-lock.json\n", 0o644)
+	patch := "--- a/hello.txt\n+++ b/hello.txt\n@@ -1 +1 @@\n-before\n+after\n"
+	manager := New(root)
+	tx, err := manager.Prepare("plan-build-guard", []string{patch})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Release()
+	if _, err := manager.BuildHost(context.Background(), tx); err == nil || !strings.Contains(err.Error(), "mutated source dependency metadata") {
+		t.Fatalf("expected build guard rejection, got %v", err)
+	}
+	if err := tx.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(root, "services", "frontend", "package-lock.json")); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("rollback should remove build-created lockfile, got %v", err)
+	}
+}
+
+func TestTransactionRejectsHarnessRuntimePaths(t *testing.T) {
+	root := fakeRoot(t)
+	manager := New(root)
+	patch := "--- /dev/null\n+++ b/.harness/state/poison.json\n@@ -0,0 +1 @@\n+{}\n"
+	if _, err := manager.Prepare("plan-runtime-owned", []string{patch}); err == nil || !strings.Contains(err.Error(), "runtime-owned path .harness/state/poison.json") {
+		t.Fatalf("expected runtime-owned path rejection, got %v", err)
+	}
+}
diff --git a/services/backend/internal/selfevolution/transaction.go b/services/backend/internal/selfevolution/transaction.go
new file mode 100644
index 0000000..386e04b
--- /dev/null
+++ b/services/backend/internal/selfevolution/transaction.go
@@ -0,0 +1,227 @@
+package selfevolution
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+type sourceBackup struct {
+	Path    string `json:"path"`
+	Existed bool   `json:"existed"`
+	Backup  string `json:"backup,omitempty"`
+	Mode    uint32 `json:"mode,omitempty"`
+}
+
+var buildGuardPaths = []string{
+	"services/backend/go.mod",
+	"services/backend/go.sum",
+	"services/frontend/package.json",
+	"services/frontend/package-lock.json",
+	"services/desktop/package.json",
+	"services/desktop/package-lock.json",
+}
+
+func (tx Transaction) captureSource(patches []string) error {
+	paths := map[string]struct{}{}
+	for _, patch := range patches {
+		for _, path := range patchPaths(patch) {
+			if runtimeOwnedPath(path) {
+				return fmt.Errorf("self-evolution refuses runtime-owned path %s", path)
+			}
+			paths[path] = struct{}{}
+		}
+	}
+	if len(paths) == 0 {
+		return errors.New("self-evolution patch did not expose any file paths")
+	}
+	for _, path := range buildGuardPaths {
+		paths[path] = struct{}{}
+	}
+	backups := make([]sourceBackup, 0, len(paths))
+	for index, relative := range uniqueSorted(paths) {
+		absolute, err := containedPath(tx.Root, relative)
+		if err != nil {
+			return err
+		}
+		info, err := os.Lstat(absolute)
+		if errors.Is(err, os.ErrNotExist) {
+			backups = append(backups, sourceBackup{Path: relative})
+			continue
+		}
+		if err != nil {
+			return err
+		}
+		if !info.Mode().IsRegular() {
+			return fmt.Errorf("self-evolution refuses non-regular target %s", relative)
+		}
+		backupName := fmt.Sprintf("source/%04d.bin", index)
+		if err := copyFile(absolute, filepath.Join(tx.Dir, backupName), info.Mode()); err != nil {
+			return fmt.Errorf("backup %s: %w", relative, err)
+		}
+		backups = append(backups, sourceBackup{Path: relative, Existed: true, Backup: backupName, Mode: uint32(info.Mode().Perm())})
+	}
+	data, err := json.MarshalIndent(backups, "", "  ")
+	if err != nil {
+		return err
+	}
+	if err := os.WriteFile(filepath.Join(tx.Dir, "source-backup.json"), append(data, '\n'), 0o600); err != nil {
+		return err
+	}
+	return tx.writeRollback(backups)
+}
+
+func (tx Transaction) captureRuntime() error {
+	runtimeDir := filepath.Join(tx.Dir, "runtime")
+	if err := os.MkdirAll(runtimeDir, 0o700); err != nil {
+		return err
+	}
+	for _, item := range []struct{ source, destination string }{
+		{filepath.Join(tx.Root, "dist"), filepath.Join(runtimeDir, "root-dist")},
+		{filepath.Join(tx.Root, "services", "frontend", "dist"), filepath.Join(runtimeDir, "frontend-dist")},
+	} {
+		if stat, err := os.Stat(item.source); err == nil && stat.IsDir() {
+			if output, err := exec.Command("cp", "-a", item.source, item.destination).CombinedOutput(); err != nil {
+				return fmt.Errorf("backup runtime artifacts: %w: %s", err, strings.TrimSpace(string(output)))
+			}
+		}
+	}
+	stamp := filepath.Join(tx.Root, ".harness", "build-success")
+	if info, err := os.Stat(stamp); err == nil && info.Mode().IsRegular() {
+		if err := copyFile(stamp, filepath.Join(runtimeDir, "build-success"), info.Mode()); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (tx Transaction) captureLifecycleScripts() error {
+	for _, name := range []string{"self-restart.sh", "start.sh", "stop.sh"} {
+		source := filepath.Join(tx.Root, "scripts", name)
+		_, err := os.Stat(source)
+		if err != nil {
+			return fmt.Errorf("self-evolution lifecycle script %s unavailable: %w", name, err)
+		}
+		destination := filepath.Join(tx.Dir, map[string]string{"self-restart.sh": "worker.sh", "start.sh": "start-known-good.sh", "stop.sh": "stop-known-good.sh"}[name])
+		if err := copyFile(source, destination, 0o700); err != nil {
+			return err
+		}
+		if err := os.Chmod(destination, 0o700); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (tx Transaction) writeMetadata(planID string) error {
+	data := map[string]string{"transaction_id": tx.ID, "plan_id": planID, "root": tx.Root}
+	raw, err := json.MarshalIndent(data, "", "  ")
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(filepath.Join(tx.Dir, "transaction.json"), append(raw, '\n'), 0o600)
+}
+
+func (tx Transaction) writeRollback(backups []sourceBackup) error {
+	var script strings.Builder
+	script.WriteString("#!/usr/bin/env sh\nset -eu\nROOT=$1\nTXN=$2\n")
+	script.WriteString("case \"$TXN\" in \"$ROOT\"/.harness/self-evolution/txn-*) ;; *) echo 'invalid self-evolution transaction path' >&2; exit 2;; esac\n")
+	for _, backup := range backups {
+		destination := shellVarPath("ROOT", backup.Path)
+		if backup.Existed {
+			script.WriteString("mkdir -p ")
+			script.WriteString(shellVarPath("ROOT", filepath.Dir(backup.Path)))
+			script.WriteString("\ncp -p ")
+			script.WriteString(shellVarPath("TXN", backup.Backup))
+			script.WriteString(" ")
+			script.WriteString(destination)
+			script.WriteString("\nchmod ")
+			script.WriteString(strconv.FormatUint(uint64(backup.Mode), 8))
+			script.WriteString(" ")
+			script.WriteString(destination)
+			script.WriteString("\n")
+		} else {
+			script.WriteString("rm -f ")
+			script.WriteString(destination)
+			script.WriteString("\n")
+		}
+	}
+	script.WriteString("rm -rf \"$ROOT/dist\" \"$ROOT/services/frontend/dist\"\n")
+	script.WriteString("[ ! -d \"$TXN/runtime/root-dist\" ] || cp -a \"$TXN/runtime/root-dist\" \"$ROOT/dist\"\n")
+	script.WriteString("[ ! -d \"$TXN/runtime/frontend-dist\" ] || cp -a \"$TXN/runtime/frontend-dist\" \"$ROOT/services/frontend/dist\"\n")
+	script.WriteString("if [ -f \"$TXN/runtime/build-success\" ]; then mkdir -p \"$ROOT/.harness\"; cp -p \"$TXN/runtime/build-success\" \"$ROOT/.harness/build-success\"; touch \"$ROOT/.harness/build-success\"; else rm -f \"$ROOT/.harness/build-success\"; fi\n")
+	if err := os.WriteFile(tx.RollbackScript, []byte(script.String()), 0o700); err != nil {
+		return err
+	}
+	return os.Chmod(tx.RollbackScript, 0o700)
+}
+
+func shellVarPath(variable, relative string) string {
+	return "\"$" + variable + "/\"" + shellLiteral(relative)
+}
+
+func shellLiteral(value string) string {
+	return "'" + strings.ReplaceAll(value, "'", "'\"'\"'") + "'"
+}
+
+func patchPaths(patch string) []string {
+	paths := map[string]struct{}{}
+	add := func(value string) {
+		value = strings.TrimSpace(value)
+		if fields := strings.Fields(value); len(fields) > 0 {
+			value = fields[0]
+		}
+		if value == "" || value == "/dev/null" {
+			return
+		}
+		value = strings.TrimPrefix(value, "a/")
+		value = strings.TrimPrefix(value, "b/")
+		value = filepath.Clean(value)
+		if value != "." && value != ".." && !filepath.IsAbs(value) && !strings.HasPrefix(value, ".."+string(filepath.Separator)) {
+			paths[value] = struct{}{}
+		}
+	}
+	for _, line := range strings.Split(patch, "\n") {
+		switch {
+		case strings.HasPrefix(line, "diff --git "):
+			fields := strings.Fields(strings.TrimPrefix(line, "diff --git "))
+			if len(fields) == 2 {
+				add(fields[0])
+				add(fields[1])
+			}
+		case strings.HasPrefix(line, "--- "), strings.HasPrefix(line, "+++ "):
+			add(line[4:])
+		case strings.HasPrefix(line, "rename from "):
+			add(strings.TrimPrefix(line, "rename from "))
+		case strings.HasPrefix(line, "rename to "):
+			add(strings.TrimPrefix(line, "rename to "))
+		case strings.HasPrefix(line, "copy from "):
+			add(strings.TrimPrefix(line, "copy from "))
+		case strings.HasPrefix(line, "copy to "):
+			add(strings.TrimPrefix(line, "copy to "))
+		}
+	}
+	return uniqueSorted(paths)
+}
+
+func runtimeOwnedPath(relative string) bool {
+	relative = filepath.ToSlash(filepath.Clean(relative))
+	return relative == ".harness" || strings.HasPrefix(relative, ".harness/")
+}
+
+func containedPath(root, relative string) (string, error) {
+	if strings.ContainsAny(relative, "\x00\r\n") {
+		return "", errors.New("unsafe self-evolution path")
+	}
+	absolute := filepath.Join(root, relative)
+	rel, err := filepath.Rel(root, absolute)
+	if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return "", fmt.Errorf("self-evolution path escapes root: %s", relative)
+	}
+	return absolute, nil
+}
