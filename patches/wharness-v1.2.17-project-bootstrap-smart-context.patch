@@ -0,0 +1,43 @@
+package projectconfig
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+func TestEnsureCreatesWhanessConfigAndRoundTrips(t *testing.T) {
+	root := t.TempDir()
+	cfg, created, err := Ensure(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !created || !cfg.Context.AutoExclude {
+		t.Fatalf("unexpected config: created=%v cfg=%+v", created, cfg)
+	}
+	if _, err := os.Stat(filepath.Join(root, FileName)); err != nil {
+		t.Fatalf("%s not created: %v", FileName, err)
+	}
+	cfg.Context.Include = []string{"src/**", "go.mod"}
+	cfg.Context.Exclude = []string{"fixtures/**", "*.generated.ts"}
+	cfg.Context.MaxFileBytes = 4 * 1024 * 1024
+	if err := Save(root, cfg); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := Load(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cfg, loaded) {
+		t.Fatalf("round trip mismatch:\nwant %#v\n got %#v", cfg, loaded)
+	}
+}
+
+func TestValidateRejectsTraversalPattern(t *testing.T) {
+	cfg := Default(t.TempDir())
+	cfg.Context.Exclude = []string{"../outside"}
+	if err := Validate(&cfg); err == nil {
+		t.Fatal("expected traversal pattern rejection")
+	}
+}
diff --git a/services/backend/internal/projectconfig/format.go b/services/backend/internal/projectconfig/format.go
new file mode 100644
index 0000000..cfc7440
--- /dev/null
+++ b/services/backend/internal/projectconfig/format.go
@@ -0,0 +1,118 @@
+package projectconfig
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+func Validate(cfg *Config) error {
+	if cfg == nil {
+		return errors.New("project config is required")
+	}
+	if cfg.Version == 0 {
+		cfg.Version = CurrentVersion
+	}
+	if cfg.Version != CurrentVersion {
+		return fmt.Errorf("unsupported %s version %d", FileName, cfg.Version)
+	}
+	cfg.Project.Name = strings.TrimSpace(cfg.Project.Name)
+	if cfg.Context.MaxFileBytes == 0 {
+		cfg.Context.MaxFileBytes = DefaultMaxFileSize
+	}
+	if cfg.Context.MaxFileBytes < 1024 || cfg.Context.MaxFileBytes > MaxConfiguredSize {
+		return fmt.Errorf("context.max_file_bytes must be between 1024 and %d", MaxConfiguredSize)
+	}
+	var err error
+	cfg.Context.Include, err = normalizePatterns(cfg.Context.Include)
+	if err != nil {
+		return fmt.Errorf("context.include: %w", err)
+	}
+	cfg.Context.Exclude, err = normalizePatterns(cfg.Context.Exclude)
+	if err != nil {
+		return fmt.Errorf("context.exclude: %w", err)
+	}
+	return nil
+}
+
+func normalizePatterns(values []string) ([]string, error) {
+	if len(values) > 200 {
+		return nil, errors.New("at most 200 patterns are allowed")
+	}
+	seen := make(map[string]bool, len(values))
+	out := make([]string, 0, len(values))
+	for _, value := range values {
+		value = strings.TrimSpace(strings.ReplaceAll(value, "\\", "/"))
+		value = strings.TrimPrefix(value, "./")
+		if value == "" {
+			continue
+		}
+		if strings.HasPrefix(value, "/") || hasParentSegment(value) || strings.ContainsRune(value, '\x00') {
+			return nil, fmt.Errorf("pattern %q must stay relative to the project", value)
+		}
+		if !seen[value] {
+			seen[value] = true
+			out = append(out, value)
+		}
+	}
+	return out, nil
+}
+
+func hasParentSegment(value string) bool {
+	for _, segment := range strings.Split(value, "/") {
+		if segment == ".." {
+			return true
+		}
+	}
+	return false
+}
+
+func parseScalar(value string) (string, error) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return "", nil
+	}
+	if value[0] == '"' {
+		parsed, err := strconv.Unquote(value)
+		if err != nil {
+			return "", errors.New("invalid quoted string")
+		}
+		return parsed, nil
+	}
+	return value, nil
+}
+
+func render(cfg Config) string {
+	var b strings.Builder
+	b.WriteString("# Wharness project configuration. Managed by Wharness; safe to edit.\n")
+	b.WriteString("version: ")
+	b.WriteString(strconv.Itoa(cfg.Version))
+	b.WriteString("\nproject:\n  name: ")
+	b.WriteString(strconv.Quote(cfg.Project.Name))
+	b.WriteString("\ncontext:\n  auto_exclude: ")
+	b.WriteString(strconv.FormatBool(cfg.Context.AutoExclude))
+	b.WriteString("\n  max_file_bytes: ")
+	b.WriteString(strconv.FormatInt(cfg.Context.MaxFileBytes, 10))
+	if len(cfg.Context.Include) == 0 {
+		b.WriteString("\n  include: []\n")
+	} else {
+		b.WriteString("\n  include:\n")
+		for _, value := range cfg.Context.Include {
+			b.WriteString("    - ")
+			b.WriteString(strconv.Quote(value))
+			b.WriteByte('\n')
+		}
+	}
+	if len(cfg.Context.Exclude) == 0 {
+		b.WriteString("  exclude: []\n")
+	} else {
+		b.WriteString("  exclude:\n")
+		for _, value := range cfg.Context.Exclude {
+			b.WriteString("    - ")
+			b.WriteString(strconv.Quote(value))
+			b.WriteByte('\n')
+		}
+	}
+	return b.String()
+}
diff --git a/services/backend/internal/projectgit/projectgit.go b/services/backend/internal/projectgit/projectgit.go
index d179122..dc300db 100644
--- a/services/backend/internal/projectgit/projectgit.go
+++ b/services/backend/internal/projectgit/projectgit.go
@@ -42,3 +42,113 @@ func Ensure(ctx context.Context, root string) (initialized bool, err error) {
 	}
 	return true, nil
 }
+
+// Clone creates a new project checkout and recursively initializes every Git
+// submodule. The destination must not already exist, which prevents accidental
+// replacement of an existing workspace.
+func Clone(ctx context.Context, source, parent, directory string) (string, error) {
+	source = strings.TrimSpace(source)
+	if err := validateCloneSource(source); err != nil {
+		return "", err
+	}
+	parentAbs, err := filepath.Abs(strings.TrimSpace(parent))
+	if err != nil {
+		return "", fmt.Errorf("resolve clone parent: %w", err)
+	}
+	info, err := os.Stat(parentAbs)
+	if err != nil || !info.IsDir() {
+		return "", errors.New("clone parent must be an existing directory")
+	}
+	if directory == "" {
+		directory = cloneDirectoryName(source)
+	}
+	if err := validateDirectoryName(directory); err != nil {
+		return "", err
+	}
+	destination := filepath.Join(parentAbs, directory)
+	if _, err := os.Lstat(destination); err == nil {
+		return "", fmt.Errorf("clone destination already exists: %s", destination)
+	} else if !os.IsNotExist(err) {
+		return "", fmt.Errorf("inspect clone destination: %w", err)
+	}
+	if _, err := exec.LookPath("git"); err != nil {
+		return "", ErrGitUnavailable
+	}
+	cmd := exec.CommandContext(ctx, "git", "clone", "--recurse-submodules", "--", source, destination)
+	cmd.Env = append(os.Environ(), "GIT_TERMINAL_PROMPT=0")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		message := strings.ReplaceAll(strings.TrimSpace(string(output)), source, "<repository>")
+		return "", fmt.Errorf("git clone --recurse-submodules: %s", message)
+	}
+	return destination, nil
+}
+
+func validateCloneSource(source string) error {
+	if source == "" || strings.HasPrefix(source, "-") {
+		return errors.New("git repository URL/path is required")
+	}
+	if filepath.IsAbs(source) {
+		return nil
+	}
+	for _, prefix := range []string{"https://", "http://", "ssh://", "git://", "file://"} {
+		if strings.HasPrefix(source, prefix) {
+			return nil
+		}
+	}
+	at, colon := strings.Index(source, "@"), strings.Index(source, ":")
+	if at > 0 && colon > at+1 && colon < len(source)-1 {
+		return nil
+	}
+	return errors.New("git repository must be an absolute local path or a supported Git URL")
+}
+
+func cloneDirectoryName(source string) string {
+	value := strings.TrimSuffix(strings.TrimSpace(source), "/")
+	if idx := strings.LastIndex(value, ":"); idx >= 0 && !strings.Contains(value[idx+1:], "/") {
+		value = value[idx+1:]
+	}
+	value = filepath.Base(value)
+	value = strings.TrimSuffix(value, ".git")
+	if value == "." || value == string(filepath.Separator) || value == "" {
+		return "project"
+	}
+	return value
+}
+
+func validateDirectoryName(value string) error {
+	value = strings.TrimSpace(value)
+	if value == "" || value == "." || value == ".." || filepath.Base(value) != value || strings.ContainsAny(value, `/\\`) {
+		return errors.New("project directory name must be a single path segment")
+	}
+	if strings.HasPrefix(value, "-") {
+		return errors.New("project directory name must not start with '-'")
+	}
+	return nil
+}
+
+// Create makes an empty project directory and initializes its Git boundary.
+func Create(ctx context.Context, parent, directory string) (string, error) {
+	parentAbs, err := filepath.Abs(strings.TrimSpace(parent))
+	if err != nil {
+		return "", fmt.Errorf("resolve project parent: %w", err)
+	}
+	info, err := os.Stat(parentAbs)
+	if err != nil || !info.IsDir() {
+		return "", errors.New("project parent must be an existing directory")
+	}
+	if err := validateDirectoryName(directory); err != nil {
+		return "", err
+	}
+	root := filepath.Join(parentAbs, strings.TrimSpace(directory))
+	if err := os.Mkdir(root, 0o755); err != nil {
+		if os.IsExist(err) {
+			return "", fmt.Errorf("project directory already exists: %s", root)
+		}
+		return "", fmt.Errorf("create project directory: %w", err)
+	}
+	if _, err := Ensure(ctx, root); err != nil {
+		_ = os.RemoveAll(root)
+		return "", err
+	}
+	return root, nil
+}
diff --git a/services/backend/internal/projectgit/projectgit_test.go b/services/backend/internal/projectgit/projectgit_test.go
index 6d621e9..633962c 100644
--- a/services/backend/internal/projectgit/projectgit_test.go
+++ b/services/backend/internal/projectgit/projectgit_test.go
@@ -87,3 +87,77 @@ func stringTrimSpace(value string) string {
 	}
 	return value
 }
+
+func TestCloneRecursivelyInitializesSubmodules(t *testing.T) {
+	requireGit(t)
+	root := t.TempDir()
+	sub := filepath.Join(root, "sub")
+	main := filepath.Join(root, "main")
+	for _, repo := range []string{sub, main} {
+		if err := os.Mkdir(repo, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := Ensure(context.Background(), repo); err != nil {
+			t.Fatal(err)
+		}
+		runGit(t, repo, "config", "user.email", "test@example.invalid")
+		runGit(t, repo, "config", "user.name", "Wharness Test")
+	}
+	if err := os.WriteFile(filepath.Join(sub, "sub.txt"), []byte("submodule\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	runGit(t, sub, "add", "sub.txt")
+	runGit(t, sub, "commit", "-qm", "sub")
+	if err := os.WriteFile(filepath.Join(main, "main.txt"), []byte("main\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	runGit(t, main, "add", "main.txt")
+	runGit(t, main, "commit", "-qm", "main")
+	cmd := exec.Command("git", "-c", "protocol.file.allow=always", "-C", main, "submodule", "add", sub, "modules/sub")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("add submodule: %s", output)
+	}
+	runGit(t, main, "commit", "-qam", "submodule")
+
+	parent := filepath.Join(root, "clones")
+	if err := os.Mkdir(parent, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	t.Setenv("GIT_ALLOW_PROTOCOL", "file")
+	cloned, err := Clone(ctx, main, parent, "checkout")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(cloned, "modules", "sub", "sub.txt")); err != nil {
+		t.Fatalf("recursive submodule content missing: %v", err)
+	}
+}
+
+func TestCloneRejectsUnsafeDirectoryName(t *testing.T) {
+	_, err := Clone(context.Background(), "https://example.invalid/repo.git", t.TempDir(), "../escape")
+	if err == nil {
+		t.Fatal("expected unsafe directory rejection")
+	}
+}
+
+func runGit(t *testing.T, root string, args ...string) {
+	t.Helper()
+	full := append([]string{"-C", root}, args...)
+	cmd := exec.Command("git", full...)
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("git %v: %s", args, output)
+	}
+}
+
+func TestCreateInitializesNewProject(t *testing.T) {
+	requireGit(t)
+	parent := t.TempDir()
+	root, err := Create(context.Background(), parent, "fresh-project")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(root, ".git")); err != nil {
+		t.Fatalf("new project git boundary missing: %v", err)
+	}
+}
