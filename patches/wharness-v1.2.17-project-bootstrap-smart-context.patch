+	}
+	if matchConfiguredPattern("src/pkg/main.go", "src/**") != true {
+		t.Fatal("globstar include should match descendants")
+	}
+}
diff --git a/services/backend/internal/contextbundle/filtering.go b/services/backend/internal/contextbundle/filtering.go
new file mode 100644
index 0000000..103505b
--- /dev/null
+++ b/services/backend/internal/contextbundle/filtering.go
@@ -0,0 +1,129 @@
+package contextbundle
+
+import (
+	"path"
+	"strings"
+
+	"kernl.local/harness/backend/internal/projectconfig"
+)
+
+func contextExclusion(rel string, isDir bool, legacyPatterns []string, cfg projectconfig.ContextConfig) (string, bool) {
+	if ShouldIgnoreWithPatterns(rel, isDir, legacyPatterns) {
+		return "harness ignore", true
+	}
+	if matchAny(rel, cfg.Exclude) {
+		return "project config exclude", true
+	}
+	if !isDir && len(cfg.Include) > 0 && !matchAny(rel, cfg.Include) {
+		return "not selected by project config include", true
+	}
+	if cfg.AutoExclude && !explicitIncludeKeeps(rel, isDir, cfg.Include) {
+		if reason, ignored := autoExclude(rel, isDir); ignored {
+			return reason, true
+		}
+	}
+	return "", false
+}
+
+func explicitIncludeKeeps(rel string, isDir bool, patterns []string) bool {
+	if len(patterns) == 0 {
+		return false
+	}
+	if matchAny(rel, patterns) {
+		return true
+	}
+	if !isDir {
+		return false
+	}
+	rel = strings.TrimSuffix(strings.TrimPrefix(filepathSlash(rel), "./"), "/")
+	for _, pattern := range patterns {
+		pattern = strings.TrimPrefix(filepathSlash(strings.TrimSpace(pattern)), "./")
+		if strings.HasPrefix(pattern, rel+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+func autoExclude(rel string, isDir bool) (string, bool) {
+	rel = strings.TrimPrefix(filepathSlash(rel), "./")
+	parts := strings.Split(strings.ToLower(rel), "/")
+	base := parts[len(parts)-1]
+	if isDir {
+		if strings.HasPrefix(base, "kernl-context-") || strings.HasPrefix(base, "wharness-context-") {
+			return "generated context snapshot", true
+		}
+		dirs := map[string]string{
+			".svn": "vcs metadata", ".hg": "vcs metadata",
+			".idea": "ide metadata", ".vscode": "ide metadata",
+			"__pycache__": "language cache", ".pytest_cache": "test cache", ".mypy_cache": "language cache", ".ruff_cache": "language cache",
+			".venv": "dependency environment", "venv": "dependency environment",
+			"target": "generated build output", "out": "generated build output", ".gradle": "build cache",
+			".dart_tool": "dependency cache", ".terraform": "dependency cache", ".serverless": "generated deployment output", "pods": "dependency cache",
+			"playwright-report": "test output", "test-results": "test output", ".cache": "tool cache", ".parcel-cache": "tool cache",
+			"tmp": "temporary output", "temp": "temporary output",
+		}
+		if reason := dirs[base]; reason != "" {
+			return reason, true
+		}
+		return "", false
+	}
+	if base == ".ds_store" || base == "thumbs.db" || base == "desktop.ini" {
+		return "os metadata", true
+	}
+	for _, suffix := range []string{".log", ".tmp", ".temp", ".swp", ".swo", ".orig", ".rej", "~", ".pyc", ".pyo", ".class", ".o", ".obj", ".a", ".so", ".dylib", ".dll", ".exe", ".bin", ".tsbuildinfo"} {
+		if strings.HasSuffix(base, suffix) {
+			return "generated or binary artifact", true
+		}
+	}
+	for _, suffix := range []string{".zip", ".tar", ".tgz", ".gz", ".bz2", ".xz", ".7z", ".rar", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico", ".pdf", ".mp3", ".mp4", ".mov", ".avi", ".woff", ".woff2", ".ttf", ".otf"} {
+		if strings.HasSuffix(base, suffix) {
+			return "non-source asset", true
+		}
+	}
+	return "", false
+}
+
+func matchAny(rel string, patterns []string) bool {
+	rel = strings.TrimPrefix(filepathSlash(rel), "./")
+	for _, pattern := range patterns {
+		if matchConfiguredPattern(rel, pattern) {
+			return true
+		}
+	}
+	return false
+}
+
+func matchConfiguredPattern(rel, pattern string) bool {
+	pattern = strings.TrimPrefix(filepathSlash(strings.TrimSpace(pattern)), "./")
+	pattern = strings.TrimSuffix(pattern, "/")
+	if pattern == "" {
+		return false
+	}
+	if !strings.Contains(pattern, "/") {
+		matched, _ := path.Match(pattern, path.Base(rel))
+		return matched || rel == pattern || strings.HasPrefix(rel, pattern+"/")
+	}
+	return matchSegments(strings.Split(pattern, "/"), strings.Split(rel, "/"))
+}
+
+func matchSegments(pattern, value []string) bool {
+	if len(pattern) == 0 {
+		return len(value) == 0
+	}
+	if pattern[0] == "**" {
+		if matchSegments(pattern[1:], value) {
+			return true
+		}
+		return len(value) > 0 && matchSegments(pattern, value[1:])
+	}
+	if len(value) == 0 {
+		return false
+	}
+	matched, err := path.Match(pattern[0], value[0])
+	return err == nil && matched && matchSegments(pattern[1:], value[1:])
+}
+
+func filepathSlash(value string) string {
+	return strings.ReplaceAll(value, "\\", "/")
+}
diff --git a/services/backend/internal/projectconfig/config.go b/services/backend/internal/projectconfig/config.go
new file mode 100644
index 0000000..73053b7
--- /dev/null
+++ b/services/backend/internal/projectconfig/config.go
@@ -0,0 +1,198 @@
+package projectconfig
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+const (
+	FileName           = "whaness.yml"
+	CurrentVersion     = 1
+	DefaultMaxFileSize = int64(2 * 1024 * 1024)
+	MaxConfiguredSize  = int64(64 * 1024 * 1024)
+)
+
+type Config struct {
+	Version int           `json:"version"`
+	Project ProjectConfig `json:"project"`
+	Context ContextConfig `json:"context"`
+}
+
+type ProjectConfig struct {
+	Name string `json:"name"`
+}
+
+type ContextConfig struct {
+	AutoExclude  bool     `json:"auto_exclude"`
+	MaxFileBytes int64    `json:"max_file_bytes"`
+	Include      []string `json:"include"`
+	Exclude      []string `json:"exclude"`
+}
+
+func Default(root string) Config {
+	return Config{
+		Version: CurrentVersion,
+		Project: ProjectConfig{Name: filepath.Base(filepath.Clean(root))},
+		Context: ContextConfig{
+			AutoExclude:  true,
+			MaxFileBytes: DefaultMaxFileSize,
+			Include:      []string{},
+			Exclude:      []string{},
+		},
+	}
+}
+
+func Ensure(root string) (Config, bool, error) {
+	filename := filepath.Join(root, FileName)
+	if _, err := os.Stat(filename); err == nil {
+		cfg, err := Load(root)
+		return cfg, false, err
+	} else if !os.IsNotExist(err) {
+		return Config{}, false, fmt.Errorf("inspect %s: %w", FileName, err)
+	}
+	cfg := Default(root)
+	if err := Save(root, cfg); err != nil {
+		return Config{}, false, err
+	}
+	return cfg, true, nil
+}
+
+func Load(root string) (Config, error) {
+	file, err := os.Open(filepath.Join(root, FileName))
+	if err != nil {
+		return Config{}, fmt.Errorf("open %s: %w", FileName, err)
+	}
+	defer file.Close()
+
+	cfg := Default(root)
+	section, listKey := "", ""
+	scanner := bufio.NewScanner(file)
+	for lineNo := 1; scanner.Scan(); lineNo++ {
+		raw := scanner.Text()
+		trimmed := strings.TrimSpace(raw)
+		if trimmed == "" || strings.HasPrefix(trimmed, "#") {
+			continue
+		}
+		indent := len(raw) - len(strings.TrimLeft(raw, " \t"))
+		if strings.HasPrefix(trimmed, "- ") {
+			if section != "context" || listKey == "" {
+				return Config{}, fmt.Errorf("%s:%d: list item outside context include/exclude", FileName, lineNo)
+			}
+			value, err := parseScalar(strings.TrimSpace(strings.TrimPrefix(trimmed, "- ")))
+			if err != nil {
+				return Config{}, fmt.Errorf("%s:%d: %w", FileName, lineNo, err)
+			}
+			if listKey == "include" {
+				cfg.Context.Include = append(cfg.Context.Include, value)
+			} else {
+				cfg.Context.Exclude = append(cfg.Context.Exclude, value)
+			}
+			continue
+		}
+		key, value, ok := strings.Cut(trimmed, ":")
+		if !ok {
+			return Config{}, fmt.Errorf("%s:%d: expected key: value", FileName, lineNo)
+		}
+		key, value = strings.TrimSpace(key), strings.TrimSpace(value)
+		if indent == 0 {
+			listKey = ""
+			switch key {
+			case "version":
+				parsed, err := strconv.Atoi(value)
+				if err != nil {
+					return Config{}, fmt.Errorf("%s:%d: invalid version", FileName, lineNo)
+				}
+				cfg.Version = parsed
+				section = ""
+			case "project", "context":
+				if value != "" {
+					return Config{}, fmt.Errorf("%s:%d: section %s must not have an inline value", FileName, lineNo, key)
+				}
+				section = key
+			default:
+				section = ""
+			}
+			continue
+		}
+		if section == "project" && key == "name" {
+			cfg.Project.Name, err = parseScalar(value)
+			if err != nil {
+				return Config{}, fmt.Errorf("%s:%d: %w", FileName, lineNo, err)
+			}
+			continue
+		}
+		if section != "context" {
+			continue
+		}
+		switch key {
+		case "auto_exclude":
+			parsed, err := strconv.ParseBool(value)
+			if err != nil {
+				return Config{}, fmt.Errorf("%s:%d: invalid auto_exclude", FileName, lineNo)
+			}
+			cfg.Context.AutoExclude = parsed
+			listKey = ""
+		case "max_file_bytes":
+			parsed, err := strconv.ParseInt(value, 10, 64)
+			if err != nil {
+				return Config{}, fmt.Errorf("%s:%d: invalid max_file_bytes", FileName, lineNo)
+			}
+			cfg.Context.MaxFileBytes = parsed
+			listKey = ""
+		case "include", "exclude":
+			if value != "" && value != "[]" {
+				return Config{}, fmt.Errorf("%s:%d: %s must be a YAML list", FileName, lineNo, key)
+			}
+			if key == "include" {
+				cfg.Context.Include = []string{}
+			} else {
+				cfg.Context.Exclude = []string{}
+			}
+			listKey = key
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return Config{}, fmt.Errorf("read %s: %w", FileName, err)
+	}
+	if err := Validate(&cfg); err != nil {
+		return Config{}, err
+	}
+	return cfg, nil
+}
+
+func Save(root string, cfg Config) error {
+	if err := Validate(&cfg); err != nil {
+		return err
+	}
+	data := []byte(render(cfg))
+	filename := filepath.Join(root, FileName)
+	tmp, err := os.CreateTemp(root, ".whaness-*.tmp")
+	if err != nil {
+		return fmt.Errorf("create temporary %s: %w", FileName, err)
+	}
+	tmpName := tmp.Name()
+	defer os.Remove(tmpName)
+	if err := tmp.Chmod(0o644); err != nil {
+		tmp.Close()
+		return err
+	}
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close()
+		return fmt.Errorf("write %s: %w", FileName, err)
+	}
+	if err := tmp.Sync(); err != nil {
+		tmp.Close()
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(tmpName, filename); err != nil {
+		return fmt.Errorf("install %s: %w", FileName, err)
+	}
+	return nil
+}
