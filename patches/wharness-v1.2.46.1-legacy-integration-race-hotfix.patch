+## v1.2.46.1 legacy integration-race classifier hotfix
+
+- Regression extends `TestLegacyFailureKindRecognizesPersistedPingPongCauses` across both legacy persistence surfaces: `LastRepairError` and `LastExecution.Error`.
+- The classifier lowercases both the persisted detail and the `ErrHostIntegrationRace` sentinel before matching, so the mixed-case `ChangeSet` token cannot silently disable `host_integration_race` recovery after reload.
+- Patch-construction environment: `gofmt` and `git diff --check` pass. The focused Go test cannot start here because the supplied source export omits `github.com/jackc/pgx/v5` from the module cache and outbound access to `proxy.golang.org` is blocked; the operator batch runs the canonical backend/frontend gates in the hydrated workspace.
+
 ## v1.2.46 concurrency recovery + fixed chat header
 
 - `service_recovery_hardening_test.go` covers verification-only pending-plan filtering, local failure classification (`self_evolution_transaction_busy`, `stale_host_baseline`, `host_integration_race`, `execution_context_canceled`), planner reason-code classification and ChangeSet race restaging and stale-candidate revalidation where a verification failure is unchanged from the current host baseline, plus canceled exit -1 propagation so renderer/request cancellation cannot fabricate a source repair.
diff --git a/services/backend/internal/app/service_dependency_network.go b/services/backend/internal/app/service_dependency_network.go
index 887441f..75e469b 100644
--- a/services/backend/internal/app/service_dependency_network.go
+++ b/services/backend/internal/app/service_dependency_network.go
@@ -124,18 +124,24 @@ func sessionFailureKind(item domain.Session) string {
 	if item.LastExecution != nil && selfevolution.IsHostToolchainMismatch(item.LastExecution.Error) {
 		return domain.FailureKindHostBuildToolchain
 	}
-	legacyDetail := strings.ToLower(item.LastRepairError)
-	if strings.Contains(legacyDetail, strings.ToLower(selfevolution.ErrBusy.Error())) {
-		return domain.FailureKindSelfEvolutionBusy
-	}
-	if strings.Contains(legacyDetail, "host apply blocked by stale baseline") || strings.Contains(legacyDetail, "stale_pending_baseline") {
-		return domain.FailureKindStaleHostBaseline
-	}
-	if strings.Contains(legacyDetail, ErrHostIntegrationRace.Error()) {
-		return domain.FailureKindHostIntegrationRace
-	}
-	if strings.Contains(legacyDetail, context.Canceled.Error()) {
-		return domain.FailureKindExecutionCanceled
+	legacyDetails := []string{item.LastRepairError}
+	if item.LastExecution != nil {
+		legacyDetails = append(legacyDetails, item.LastExecution.Error)
+	}
+	for _, detail := range legacyDetails {
+		legacyDetail := strings.ToLower(detail)
+		if strings.Contains(legacyDetail, strings.ToLower(selfevolution.ErrBusy.Error())) {
+			return domain.FailureKindSelfEvolutionBusy
+		}
+		if strings.Contains(legacyDetail, "host apply blocked by stale baseline") || strings.Contains(legacyDetail, "stale_pending_baseline") {
+			return domain.FailureKindStaleHostBaseline
+		}
+		if strings.Contains(legacyDetail, strings.ToLower(ErrHostIntegrationRace.Error())) {
+			return domain.FailureKindHostIntegrationRace
+		}
+		if strings.Contains(legacyDetail, context.Canceled.Error()) {
+			return domain.FailureKindExecutionCanceled
+		}
 	}
 	return ""
 }
