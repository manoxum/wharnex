diff --git a/services/backend/internal/sandbox/docker_lifecycle.go b/services/backend/internal/sandbox/docker_lifecycle.go
new file mode 100644
index 0000000..6f918ed
--- /dev/null
+++ b/services/backend/internal/sandbox/docker_lifecycle.go
@@ -0,0 +1,34 @@
+package sandbox
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"runtime"
+)
+
+var errDockerSocketActivation = errors.New("docker.socket is active while docker.service is stopped; Wharness refuses to auto-start Docker because daemon startup can change host networking; start Docker explicitly, then retry")
+
+func refuseDockerSocketActivation() error {
+	if runtime.GOOS != "linux" || os.Getenv("DOCKER_HOST") != "" {
+		return nil
+	}
+	if _, err := exec.LookPath("systemctl"); err != nil {
+		return nil
+	}
+	return dockerSocketActivationPolicy(
+		systemdUnitActive("docker.service"),
+		systemdUnitActive("docker.socket"),
+	)
+}
+
+func systemdUnitActive(unit string) bool {
+	return exec.Command("systemctl", "is-active", "--quiet", unit).Run() == nil
+}
+
+func dockerSocketActivationPolicy(serviceActive, socketActive bool) error {
+	if !serviceActive && socketActive {
+		return errDockerSocketActivation
+	}
+	return nil
+}
diff --git a/services/backend/internal/sandbox/docker_lifecycle_test.go b/services/backend/internal/sandbox/docker_lifecycle_test.go
new file mode 100644
index 0000000..1cf0e72
--- /dev/null
+++ b/services/backend/internal/sandbox/docker_lifecycle_test.go
@@ -0,0 +1,25 @@
+package sandbox
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestDockerSocketActivationPolicyRejectsStoppedServiceWithListeningSocket(t *testing.T) {
+	err := dockerSocketActivationPolicy(false, true)
+	if !errors.Is(err, errDockerSocketActivation) {
+		t.Fatalf("expected socket-activation rejection, got %v", err)
+	}
+}
+
+func TestDockerSocketActivationPolicyAllowsAlreadyRunningService(t *testing.T) {
+	if err := dockerSocketActivationPolicy(true, true); err != nil {
+		t.Fatalf("running Docker service should be allowed: %v", err)
+	}
+}
+
+func TestDockerSocketActivationPolicyAllowsInactiveSocket(t *testing.T) {
+	if err := dockerSocketActivationPolicy(false, false); err != nil {
+		t.Fatalf("inactive Docker socket cannot socket-activate the daemon: %v", err)
+	}
+}
