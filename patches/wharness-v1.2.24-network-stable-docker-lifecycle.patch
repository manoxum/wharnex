diff --git a/scripts/docker-daemon-guard.sh b/scripts/docker-daemon-guard.sh
new file mode 100755
index 0000000..7b1e28f
--- /dev/null
+++ b/scripts/docker-daemon-guard.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env sh
+set -eu
+
+# Docker socket activation is useful for general CLI ergonomics, but it is unsafe
+# for Wharness to trigger implicitly: starting dockerd can recreate bridges,
+# routes, NAT rules and veth devices while Electron/Chromium has live requests.
+if [ "$(uname -s 2>/dev/null || printf unknown)" != "Linux" ]; then
+  exit 0
+fi
+
+# An explicit Docker endpoint is operator-owned and is not the host systemd
+# socket that this guard is intended to protect.
+if [ -n "${DOCKER_HOST:-}" ]; then
+  exit 0
+fi
+
+if ! command -v systemctl >/dev/null 2>&1; then
+  exit 0
+fi
+
+if systemctl is-active --quiet docker.service 2>/dev/null; then
+  exit 0
+fi
+
+if systemctl is-active --quiet docker.socket 2>/dev/null; then
+  cat >&2 <<'MSG'
+Wharness refused to socket-activate Docker.
+
+docker.socket is active but docker.service is stopped. Invoking Docker here can
+start dockerd and recreate host bridges/routes/veth interfaces, which may cause
+Electron/Chromium ERR_NETWORK_CHANGED failures.
+
+Start Docker explicitly when you intend to use the Protected runner, then retry:
+  sudo systemctl start docker.service
+MSG
+  exit 1
+fi
+
+exit 0
diff --git a/scripts/lifecycle-check.sh b/scripts/lifecycle-check.sh
new file mode 100755
index 0000000..a85d23a
--- /dev/null
+++ b/scripts/lifecycle-check.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env sh
+set -eu
+
+ROOT=${WHARNESS_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}
+MAKEFILE="$ROOT/Makefile"
+START="$ROOT/scripts/start.sh"
+
+section() {
+  target=$1
+  awk -v header="$target:" '
+    $0 == header { inside=1; next }
+    inside && /^[A-Za-z0-9_.-]+:/ { exit }
+    inside { print }
+  ' "$MAKEFILE"
+}
+
+build_block=$(section build)
+deps_block=$(section deps)
+
+if printf '%s\n' "$build_block" | grep -Eq 'build-runner|docker[[:space:]]+(build|run|info)'; then
+  echo 'lifecycle regression: make build must not invoke the Docker runner/daemon' >&2
+  exit 1
+fi
+
+if printf '%s\n' "$deps_block" | grep -Eq 'command -v docker|docker[[:space:]]'; then
+  echo 'lifecycle regression: normal dependencies must not require/invoke Docker' >&2
+  exit 1
+fi
+
+if grep -Fq '"$ROOT/docker" \' "$START"; then
+  echo 'lifecycle regression: Dockerfile changes must not stale the application-only build stamp' >&2
+  exit 1
+fi
+
+if ! grep -Fq 'build-runner: runner-deps' "$MAKEFILE"; then
+  echo 'lifecycle regression: runner construction must remain an explicit guarded target' >&2
+  exit 1
+fi
+
+printf 'Lifecycle network-stability checks passed.\n'
