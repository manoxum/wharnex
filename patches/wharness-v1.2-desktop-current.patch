diff --git a/services/desktop/preload.cjs b/services/desktop/preload.cjs
new file mode 100644
index 0000000..ae29547
--- /dev/null
+++ b/services/desktop/preload.cjs
@@ -0,0 +1,29 @@
+const { contextBridge, ipcRenderer } = require('electron')
+
+const invoke = (channel, payload) => ipcRenderer.invoke(channel, payload)
+
+contextBridge.exposeInMainWorld('wharnessDesktop', Object.freeze({
+  platform: process.platform,
+  chatgpt: Object.freeze({
+    show: (bounds) => invoke('wharness:chatgpt:show', bounds),
+    hide: () => invoke('wharness:chatgpt:hide'),
+    setBounds: (bounds) => invoke('wharness:chatgpt:set-bounds', bounds),
+    reload: () => invoke('wharness:chatgpt:reload'),
+    focus: () => invoke('wharness:chatgpt:focus'),
+    back: () => invoke('wharness:chatgpt:back'),
+    forward: () => invoke('wharness:chatgpt:forward'),
+    paste: () => invoke('wharness:chatgpt:paste'),
+    state: () => invoke('wharness:chatgpt:state'),
+    onState: (callback) => {
+      if (typeof callback !== 'function') return () => {}
+      const handler = (_event, state) => callback(state)
+      ipcRenderer.on('wharness:chatgpt:state', handler)
+      return () => ipcRenderer.removeListener('wharness:chatgpt:state', handler)
+    },
+  }),
+  clipboard: Object.freeze({
+    copyContextZip: (request) => invoke('wharness:clipboard:copy-context-zip', request),
+    readText: () => invoke('wharness:clipboard:read-text'),
+    writeText: (text) => invoke('wharness:clipboard:write-text', String(text)),
+  }),
+}))
diff --git a/services/desktop/security.mjs b/services/desktop/security.mjs
new file mode 100644
index 0000000..78675a5
--- /dev/null
+++ b/services/desktop/security.mjs
@@ -0,0 +1,34 @@
+export function sanitizeSessionId(value) {
+  const id = String(value || '')
+  if (!/^[a-zA-Z0-9_-]{3,160}$/.test(id)) throw new Error('Invalid Wharness session id')
+  return id
+}
+
+export function requireLocalHTTPURL(value, label = 'URL') {
+  let url
+  try { url = new URL(String(value)) } catch { throw new Error(`${label} is invalid`) }
+  const local = url.hostname === '127.0.0.1' || url.hostname === 'localhost' || url.hostname === '::1'
+  if (url.protocol !== 'http:' || !local) throw new Error(`${label} must use local HTTP`)
+  return url
+}
+
+export function contextBundleURL(backendURL, sessionId) {
+  const base = requireLocalHTTPURL(backendURL, 'Backend URL')
+  const id = sanitizeSessionId(sessionId)
+  return new URL(`/api/sessions/${encodeURIComponent(id)}/bundle`, base).href
+}
+
+export function normalizeBounds(value, area) {
+  if (!value || !area || area.width < 1 || area.height < 1) return null
+  const rawX = Math.floor(Number(value.x) || 0)
+  const rawY = Math.floor(Number(value.y) || 0)
+  const x = Math.max(0, Math.min(rawX, area.width - 1))
+  const y = Math.max(0, Math.min(rawY, area.height - 1))
+  const width = Math.max(1, Math.min(Math.floor(Number(value.width) || 1), area.width - x))
+  const height = Math.max(1, Math.min(Math.floor(Number(value.height) || 1), area.height - y))
+  return { x, y, width, height }
+}
+
+export function isHTTPS(value) {
+  try { return new URL(value).protocol === 'https:' } catch { return false }
+}
