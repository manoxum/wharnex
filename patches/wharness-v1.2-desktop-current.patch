+/* v1.2 Desktop ChatGPT composition */
+.inspector-content.desktop-content { padding: 0; overflow: hidden; background: #e5e7df; }
+.desktop-dot { width: 6px; height: 6px; border-radius: 50%; background: #82b63d; box-shadow: 0 0 0 2px #dce9cb; }
+.desktop-chatgpt-shell { height: 100%; min-height: 0; display: flex; flex-direction: column; background: #eef0e9; }
+.desktop-chatgpt-toolbar { height: 42px; flex: 0 0 42px; padding: 0 9px; display: grid; grid-template-columns: auto minmax(160px, 1fr) auto; align-items: center; gap: 8px; border-bottom: 1px solid #cfd3c8; background: #f7f8f4; }
+.desktop-browser-controls { display: flex; align-items: center; gap: 2px; }
+.icon-button.light { color: #596056; width: 27px; height: 27px; }
+.icon-button.light:hover { background: #e6e9e0; }
+.desktop-browser-address { min-width: 0; height: 28px; padding: 0 10px; display: flex; align-items: center; gap: 7px; border: 1px solid #d3d6cd; border-radius: 7px; background: #fff; color: #565b52; }
+.desktop-browser-address strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 10px; }
+.desktop-browser-address > span:last-child { margin-left: auto; color: #969b91; font: 8px ui-monospace, 'SFMono-Regular', Consolas, monospace; }
+.browser-lamp { width: 6px; height: 6px; flex: 0 0 auto; border-radius: 50%; background: #77a83a; }
+.browser-lamp.loading { background: #c69748; animation: pulse 1.2s infinite; }
+.desktop-chatgpt-actions { flex: 0 0 auto; padding: 9px 10px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; border-bottom: 1px solid #d2d5cc; background: #eceee7; }
+.desktop-step { min-width: 0; display: grid; grid-template-columns: 19px 1fr; align-items: center; gap: 5px 7px; }
+.desktop-step > span { grid-row: 1 / 3; width: 19px; height: 19px; display: grid; place-items: center; border-radius: 50%; background: #242721; color: #c7ff76; font: 8px ui-monospace, 'SFMono-Regular', Consolas, monospace; }
+.desktop-step .secondary-button { min-width: 0; width: fit-content; max-width: 100%; }
+.desktop-step small { color: #858a80; font-size: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.desktop-chatgpt-notice { flex: 0 0 auto; padding: 6px 11px; background: #e5edd9; color: #536b33; border-bottom: 1px solid #cbd7ba; font-size: 9px; line-height: 1.45; }
+.desktop-chatgpt-host { flex: 1; min-height: 230px; position: relative; background: #fff; overflow: hidden; }
+.desktop-chatgpt-loading { position: absolute; inset: 0; display: grid; place-items: center; color: #969b91; font-size: 10px; }
+.desktop-plan-import { flex: 0 0 146px; min-height: 0; padding: 8px 10px 10px; border-top: 1px solid #cbd0c5; background: #eef0e9; }
+.desktop-plan-import .field-label { margin-bottom: 6px; }
+.desktop-plan-import-row { height: 108px; display: grid; grid-template-columns: 1fr auto; gap: 7px; align-items: stretch; }
