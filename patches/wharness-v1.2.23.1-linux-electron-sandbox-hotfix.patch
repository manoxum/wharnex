+++ b/docs/development.md
@@ -1,3 +1,19 @@
 # Development
 
 Backend uses only the Go standard library in V1. Frontend uses React/Vite/TypeScript. Docker is optional for compilation but required for the default execution path.
+
+## Linux Electron sandbox
+
+Wharness never launches Electron with `--no-sandbox`. `make start` performs a Linux sandbox preflight before starting the desktop process. If the Electron-packaged `chrome-sandbox` is not root-owned mode `4755`, Wharness first probes whether unprivileged user namespaces are actually usable; when they are, Electron is launched with only `--disable-setuid-sandbox`, leaving Chromium's user-namespace/seccomp sandbox path enabled.
+
+On hosts where unprivileged user namespaces are unavailable, install a persistent SUID helper outside `node_modules` so `npm install`/`npm ci` cannot reset its ownership and mode:
+
+```sh
+sudo install -d -o root -g root -m 0755 /usr/local/lib/wharness
+sudo install -o root -g root -m 4755 \
+  services/desktop/node_modules/electron/dist/chrome-sandbox \
+  /usr/local/lib/wharness/chrome-sandbox
+make electron-sandbox-check
+```
+
+The persistent helper is accepted only when it is root-owned, mode `4755`, and byte-identical to the helper shipped by the currently installed Electron version. After an Electron upgrade, repeat the installation command. Override the persistent location only with `WHARNESS_ELECTRON_SANDBOX_PATH` when a different administrator-managed path is required.
diff --git a/scripts/electron-sandbox.sh b/scripts/electron-sandbox.sh
new file mode 100755
index 0000000..6e886ea
--- /dev/null
+++ b/scripts/electron-sandbox.sh
@@ -0,0 +1,122 @@
+#!/usr/bin/env sh
+set -eu
+
+ROOT=${WHARNESS_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}
+SOURCE_HELPER="$ROOT/services/desktop/node_modules/electron/dist/chrome-sandbox"
+PERSISTENT_HELPER=${WHARNESS_ELECTRON_SANDBOX_PATH:-/usr/local/lib/wharness/chrome-sandbox}
+
+is_linux() {
+  [ "$(uname -s 2>/dev/null || printf unknown)" = "Linux" ]
+}
+
+is_secure_setuid_helper() {
+  helper=$1
+  [ -f "$helper" ] || return 1
+  [ ! -L "$helper" ] || return 1
+  uid=$(stat -c '%u' "$helper" 2>/dev/null || return 1)
+  mode=$(stat -c '%a' "$helper" 2>/dev/null || return 1)
+  [ "$uid" = "0" ] && [ "$mode" = "4755" ]
+}
+
+persistent_helper_is_current() {
+  is_secure_setuid_helper "$PERSISTENT_HELPER" || return 1
+  [ -f "$SOURCE_HELPER" ] || return 1
+  cmp -s "$SOURCE_HELPER" "$PERSISTENT_HELPER"
+}
+
+bundled_helper_is_secure() {
+  is_secure_setuid_helper "$SOURCE_HELPER"
+}
+
+user_namespaces_available() {
+  command -v unshare >/dev/null 2>&1 || return 1
+  unshare -Ur true >/dev/null 2>&1
+}
+
+resolve_mode() {
+  if ! is_linux; then
+    printf 'none\n'
+    return 0
+  fi
+  if persistent_helper_is_current || bundled_helper_is_secure; then
+    printf 'setuid\n'
+    return 0
+  fi
+  if user_namespaces_available; then
+    printf 'userns\n'
+    return 0
+  fi
+  return 1
+}
+
+resolve_path() {
+  if persistent_helper_is_current; then
+    printf '%s\n' "$PERSISTENT_HELPER"
+    return 0
+  fi
+  if bundled_helper_is_secure; then
+    printf '%s\n' "$SOURCE_HELPER"
+    return 0
+  fi
+  return 1
+}
+
+print_failure() {
+  cat >&2 <<EOF_FAILURE
+Electron Linux sandbox is unavailable.
+
+The bundled helper is not a valid root-owned mode-4755 SUID sandbox, and
+unprivileged user namespaces could not be created. Wharness refuses to launch
+Electron with --no-sandbox.
+
+Bundled helper:
+  $SOURCE_HELPER
+
+Persistent helper expected by Wharness:
+  $PERSISTENT_HELPER
+
+Install a persistent copy once, then retry:
+  sudo install -d -o root -g root -m 0755 "$(dirname -- "$PERSISTENT_HELPER")"
+  sudo install -o root -g root -m 4755 "$SOURCE_HELPER" "$PERSISTENT_HELPER"
+  make electron-sandbox-check
+  make start
+EOF_FAILURE
+}
+
+case "${1:-check}" in
+  mode)
+    if ! resolve_mode; then
+      print_failure
+      exit 1
+    fi
+    ;;
+  path)
+    resolve_path
+    ;;
+  check)
+    if ! mode=$(resolve_mode); then
+      print_failure
+      exit 1
+    fi
+    case "$mode" in
+      none)
+        printf 'Electron sandbox preflight: non-Linux platform; no Linux helper required.\n'
+        ;;
+      setuid)
+        helper=$(resolve_path)
+        if [ "$helper" = "$PERSISTENT_HELPER" ]; then
+          printf 'Electron Linux sandbox: setuid (persistent helper: %s)\n' "$helper"
+        else
+          printf 'Electron Linux sandbox: setuid (bundled helper: %s)\n' "$helper"
+        fi
+        ;;
+      userns)
+        printf 'Electron Linux sandbox: user namespaces; invalid bundled SUID helper will be disabled, not the Chromium sandbox.\n'
+        ;;
+    esac
+    ;;
+  *)
+    echo 'usage: scripts/electron-sandbox.sh [check|mode|path]' >&2
+    exit 2
+    ;;
+esac
