+.context-settings-dialog .settings-load-error strong { color: #efb1a4; }
+.context-settings-dialog .settings-load-error p { color: #d88c7d; }
+.context-settings-dialog .settings-load-error span { color: #7d8678; }
+
+.context-config-section { padding: 18px 20px 16px; border-bottom: 1px solid #2d322b; background: #181b17; }
+.context-section-title { margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+.context-section-title > div { display: flex; flex-direction: column; gap: 2px; }
+.context-section-title strong { color: #d6ddd0; font-size: 11px; }
+.context-section-title span { color: #697267; font-size: 9px; }
+.context-section-title > code { color: #788570; font-size: 8px; }
+.context-settings-dialog .settings-toggle { border-color: #343a31; background: #11130f; }
+.context-settings-dialog .settings-toggle strong { color: #c8d0c2; }
+.context-settings-dialog .settings-toggle small,
+.context-settings-dialog .settings-grid label > small,
+.context-settings-dialog .settings-size > small { color: #697267; }
+.context-settings-dialog .settings-grid label,
+.context-settings-dialog .settings-size { color: #aeb7a9; }
+.context-settings-dialog .settings-grid textarea,
+.context-settings-dialog .settings-size input { border-color: #343a31; background: #10120f; color: #cbd3c5; }
+.context-settings-dialog .settings-grid textarea:focus,
+.context-settings-dialog .settings-size input:focus { border-color: #668e37; box-shadow: 0 0 0 1px rgba(124,169,70,.14); }
+.context-settings-dialog .settings-security-note { border-left-color: #6f963c; background: #20281b; color: #899b78; }
+.context-config-actions { margin-top: 13px; display: flex; justify-content: flex-end; }
+
+.context-explorer-section { min-height: 420px; background: #11130f; }
+.context-inspector { display: flex; flex-direction: column; min-height: 420px; }
+.context-summary-grid { padding: 12px 14px; display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 8px; border-bottom: 1px solid #292e27; background: #151813; }
+.context-summary { min-width: 0; padding: 9px 10px; display: grid; grid-template-columns: 1fr auto; gap: 2px 8px; border: 1px solid #30352d; border-radius: 7px; background: #1c201a; }
+.context-summary > span { color: #687164; font-size: 8px; text-transform: uppercase; letter-spacing: .08em; }
+.context-summary > strong { grid-column: 1 / -1; overflow: hidden; text-overflow: ellipsis; color: #d1d8cc; font: 600 15px ui-monospace, 'SFMono-Regular', Consolas, monospace; }
+.context-summary > small { grid-column: 1 / -1; color: #5e675a; font-size: 8px; }
+.context-summary.ok strong { color: #a9d477; }
+.context-summary.mono strong { font-size: 11px; }
+.context-inspector-bar { min-height: 44px; padding: 7px 10px; display: flex; align-items: center; justify-content: space-between; gap: 8px; border-bottom: 1px solid #292e27; background: #181b17; }
+.context-view-switch, .context-filter-switch { display: inline-flex; align-items: center; padding: 2px; border: 1px solid #333930; border-radius: 6px; background: #10120f; }
+.context-view-switch button, .context-filter-switch button { height: 24px; padding: 0 9px; border: 0; border-radius: 4px; background: transparent; color: #687165; font-size: 8px; font-weight: 600; cursor: pointer; }
+.context-view-switch button.active, .context-filter-switch button.active { background: #2a3027; color: #c9d3c1; }
+.context-filter-switch button.active.included { color: #b8df8a; }
+.context-filter-switch button.active.excluded { color: #e1a095; }
+.secondary-button.compact { height: 28px; padding: 0 8px; font-size: 8px; }
+.context-final-view { min-height: 0; display: flex; flex-direction: column; }
+.context-final-toolbar { padding: 8px 10px; display: flex; align-items: center; justify-content: space-between; gap: 9px; border-bottom: 1px solid #252a23; }
+.context-search { width: min(420px, 48%); height: 30px; padding: 0 7px; display: flex; align-items: center; gap: 6px; border: 1px solid #333930; border-radius: 5px; background: #0f110e; color: #606a5d; }
+.context-search:focus-within { border-color: #668d39; }
+.context-search input { min-width: 0; flex: 1; height: 26px; padding: 0; border: 0; outline: 0; background: transparent; color: #c5cdc0; font-size: 9px; }
+.context-search button { width: 20px; height: 20px; display: grid; place-items: center; border: 0; border-radius: 4px; background: transparent; color: #697366; cursor: pointer; }
+.context-inventory { max-height: 430px; overflow: auto; scrollbar-width: thin; }
+.context-inventory-row, .context-root-row { min-height: 31px; padding: 5px 10px; display: grid; grid-template-columns: 18px minmax(0,1fr) auto 72px; align-items: center; gap: 7px; border-bottom: 1px solid #20241e; color: #7a8475; }
+.context-inventory-row:hover, .context-root-row:hover { background: #191d17; }
+.context-inventory-row > svg, .context-root-row > svg { color: #6e7b64; }
+.context-inventory-row.excluded > svg, .context-root-row.excluded > svg { color: #8b6159; }
+.context-inventory-main, .context-root-row > div { min-width: 0; display: flex; flex-direction: column; gap: 1px; }
+.context-inventory-main code, .context-root-row code { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #abb5a5; font-size: 9px; }
+.context-inventory-main small, .context-root-row small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #596357; font-size: 8px; }
+.context-status { min-width: 55px; padding: 2px 5px; border-radius: 4px; background: #272b25; color: #788172; text-align: center; font: 700 7px ui-monospace, 'SFMono-Regular', Consolas, monospace; letter-spacing: .05em; }
+.context-status.included { background: #233019; color: #a7d275; }
+.context-status.excluded { background: #35201c; color: #dc9487; }
+.context-status.partial { background: #342d1d; color: #d6b46f; }
+.context-size { color: #596257; text-align: right; font: 8px ui-monospace, 'SFMono-Regular', Consolas, monospace; }
+.context-empty { padding: 34px 16px; color: #596257; text-align: center; font-size: 9px; }
+.context-list-footer { min-height: 31px; padding: 5px 10px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #292e27; color: #596257; font-size: 8px; }
+.context-list-footer button { border: 0; background: transparent; color: #8caf60; font-size: 8px; cursor: pointer; }
+.context-roots, .context-rules { max-height: 505px; overflow: auto; scrollbar-width: thin; }
+.context-section-intro { padding: 10px 12px; display: flex; flex-direction: column; gap: 2px; border-bottom: 1px solid #252a23; background: #151813; }
+.context-section-intro strong { color: #c9d1c4; font-size: 10px; }
+.context-section-intro span { color: #657064; font-size: 8px; }
+.context-rule-card { margin: 8px 10px; padding: 10px; border: 1px solid #30362d; border-radius: 7px; background: #181c17; }
+.context-rule-card.disabled { opacity: .52; }
+.context-rule-card > header { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
+.context-rule-card > header > div { display: flex; flex-direction: column; gap: 1px; }
+.context-rule-card strong { color: #cbd4c5; font-size: 9px; }
+.context-rule-card header span { color: #667062; font-size: 8px; }
+.context-rule-state { padding: 2px 5px; border-radius: 4px; background: #292d27; color: #6d7669 !important; font: 700 7px ui-monospace, 'SFMono-Regular', Consolas, monospace; }
+.context-rule-state.enabled { background: #233019; color: #a7d275 !important; }
+.context-rule-card p { margin: 7px 0; color: #747e70; font-size: 8px; line-height: 1.45; }
+.context-patterns { display: flex; flex-wrap: wrap; gap: 4px; }
+.context-patterns code { padding: 2px 5px; border: 1px solid #30362d; border-radius: 4px; background: #10120f; color: #8d9a84; font-size: 7px; }
+.context-patterns > span { color: #596257; font-size: 8px; }
+.context-inspection-error { margin: 22px; padding: 12px; display: flex; align-items: center; gap: 8px; border: 1px solid #543129; border-radius: 7px; background: #2a1916; color: #d69487; font-size: 9px; }
+.context-inspection-error button { margin-left: auto; border: 0; background: transparent; color: #e9ad9f; cursor: pointer; }
+.settings-loading.compact { min-height: 180px; padding: 20px; }
+
+@media (max-width: 900px) {
+  .context-summary-grid { grid-template-columns: 1fr 1fr; }
+  .context-final-toolbar { align-items: stretch; flex-direction: column; }
+  .context-search { width: 100%; }
+}
