+		Operations:   []domain.Operation{{Type: "apply_patch", Patch: patch}},
+		Verification: []domain.CommandSpec{{Argv: []string{"npm", "run", "build"}, Cwd: ".", TimeoutSeconds: 30, ExpectedExitCodes: []int{0}}},
