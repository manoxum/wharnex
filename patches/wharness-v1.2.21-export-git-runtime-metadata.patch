+		{"git", "config", "user.email", "test@example.invalid"},
+		{"git", "config", "user.name", "Wharness Test"},
+	}
+	for _, argv := range cmds {
+		cmd := exec.Command(argv[0], argv[1:]...)
+		cmd.Dir = root
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("%v: %v: %s", argv, err, out)
