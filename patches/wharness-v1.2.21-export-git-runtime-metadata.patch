+func TestContextFingerprintChangesWhenGitWorktreeTopologyChanges(t *testing.T) {
+	if _, err := exec.LookPath("git"); err != nil {
+		t.Skip("git not installed")
+	}
+	root := t.TempDir()
+	cmds := [][]string{
