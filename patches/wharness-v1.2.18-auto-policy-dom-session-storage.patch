+.wharness-data-section > header strong { color: #d1d8cc; font-size: 11px; }
+.wharness-data-section > header span { color: #697267; font-size: 8px; line-height: 1.45; }
+.storage-metrics { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
+.storage-metric { min-width: 0; padding: 10px; border: 1px solid #30362d; border-radius: 7px; background: #1b1f19; }
