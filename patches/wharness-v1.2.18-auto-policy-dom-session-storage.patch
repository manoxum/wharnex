+.storage-metric strong { display: block; margin-top: 3px; overflow: hidden; color: #cdd5c8; font: 600 13px ui-monospace, 'SFMono-Regular', Consolas, monospace; text-overflow: ellipsis; white-space: nowrap; }
+.project-storage-list { margin-top: 10px; border: 1px solid #30362d; border-radius: 7px; overflow: hidden; background: #11130f; }
+.project-storage-list > header { padding: 8px 10px; border-bottom: 1px solid #282d26; color: #828c7d; font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
+.project-storage-row { min-height: 34px; padding: 6px 10px; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; border-bottom: 1px solid #232820; }
+.project-storage-row:last-child { border-bottom: 0; }
+.project-storage-row.active { background: #1c2418; }
+.project-storage-row > div { min-width: 0; display: flex; flex-direction: column; gap: 1px; }
+.project-storage-row strong { overflow: hidden; color: #b9c3b3; font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
+.project-storage-row small { overflow: hidden; color: #5f695c; font: 7px ui-monospace, 'SFMono-Regular', Consolas, monospace; text-overflow: ellipsis; white-space: nowrap; }
+.project-storage-row > span { color: #8e9a88; font: 9px ui-monospace, 'SFMono-Regular', Consolas, monospace; }
+.browser-session-actions { margin-top: 12px; padding: 11px; display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; border: 1px solid #30362d; border-radius: 7px; background: #191d17; }
+.browser-session-actions > div:first-child { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
+.browser-session-actions strong { color: #c9d1c4; font-size: 9px; }
+.browser-session-actions small { max-width: 540px; color: #697267; font-size: 8px; line-height: 1.45; }
+.browser-session-actions > div:last-child { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; }
+.danger-zone { margin-top: 12px; padding: 11px; border: 1px solid #5b332c; border-radius: 7px; background: #251815; }
+.danger-zone > header { display: flex; flex-direction: column; gap: 2px; margin-bottom: 9px; }
+.danger-zone > header strong { color: #e0a297; font-size: 9px; }
+.danger-zone > header span { color: #936c64; font-size: 8px; line-height: 1.45; }
+.danger-zone label { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; }
