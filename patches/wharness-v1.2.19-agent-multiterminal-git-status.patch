new file mode 100644
index 0000000..3f2fb74
--- /dev/null
+++ b/services/frontend/src/lib/terminalWorkspace.ts
@@ -0,0 +1,140 @@
+import { useSyncExternalStore } from 'react'
+import type { CommandResult, TerminalTarget } from '../types'
+
+export type TerminalEntry = {
+  id: string
+  command: string
+  cwd: string
+  target: TerminalTarget
+  result?: CommandResult
+  error?: string
+}
+
+export type TerminalPaneState = {
+  id: string
+  title: string
+  input: string
+  target: TerminalTarget
+  hostConfirmed: boolean
+  cwdByTarget: Record<TerminalTarget, string>
+  network: boolean
+  running: boolean
+  entries: TerminalEntry[]
+  history: string[]
+  historyIndex: number
+}
+
+export type TerminalWorkspaceState = {
+  activeId: string
+  terminals: TerminalPaneState[]
+  nextNumber: number
+}
+
+type Listener = () => void
+
+const states = new Map<string, TerminalWorkspaceState>()
+const listeners = new Map<string, Set<Listener>>()
+let terminalSequence = 0
+
+function createTerminal(number: number): TerminalPaneState {
+  terminalSequence += 1
+  return {
+    id: `terminal-${terminalSequence}`,
+    title: `Terminal ${number}`,
+    input: '',
+    target: 'sandbox',
+    hostConfirmed: false,
+    cwdByTarget: { sandbox: '.', host: '.' },
+    network: false,
+    running: false,
+    entries: [],
+    history: [],
+    historyIndex: -1,
+  }
+}
+
+function initialState(): TerminalWorkspaceState {
+  const terminal = createTerminal(1)
+  return { activeId: terminal.id, terminals: [terminal], nextNumber: 2 }
+}
+
+function stateFor(sessionId: string) {
+  let state = states.get(sessionId)
+  if (!state) {
+    state = initialState()
+    states.set(sessionId, state)
+  }
+  return state
+}
+
+function emit(sessionId: string) {
+  listeners.get(sessionId)?.forEach((listener) => listener())
+}
+
+function update(sessionId: string, recipe: (state: TerminalWorkspaceState) => TerminalWorkspaceState) {
+  states.set(sessionId, recipe(stateFor(sessionId)))
+  emit(sessionId)
+}
+
+export function useTerminalWorkspace(sessionId: string) {
+  const state = useSyncExternalStore(
+    (listener) => {
+      const set = listeners.get(sessionId) || new Set<Listener>()
+      set.add(listener)
+      listeners.set(sessionId, set)
+      return () => {
+        set.delete(listener)
+        if (!set.size) listeners.delete(sessionId)
+      }
+    },
+    () => stateFor(sessionId),
+    () => stateFor(sessionId),
+  )
+
+  const active = state.terminals.find((terminal) => terminal.id === state.activeId) || state.terminals[0]
+
+  return {
+    state,
+    active,
+    addTerminal() {
+      update(sessionId, (current) => {
+        const terminal = createTerminal(current.nextNumber)
+        return { ...current, activeId: terminal.id, terminals: [...current.terminals, terminal], nextNumber: current.nextNumber + 1 }
+      })
+    },
+    selectTerminal(id: string) {
+      update(sessionId, (current) => current.terminals.some((terminal) => terminal.id === id) ? { ...current, activeId: id } : current)
+    },
+    closeTerminal(id: string) {
+      update(sessionId, (current) => {
+        if (current.terminals.length <= 1) return current
+        const index = current.terminals.findIndex((terminal) => terminal.id === id)
+        if (index < 0 || current.terminals[index].running) return current
+        const terminals = current.terminals.filter((terminal) => terminal.id !== id)
+        const activeId = current.activeId === id ? terminals[Math.min(index, terminals.length - 1)].id : current.activeId
+        return { ...current, activeId, terminals }
+      })
+    },
+    patchTerminal(id: string, patch: Partial<TerminalPaneState> | ((terminal: TerminalPaneState) => TerminalPaneState)) {
+      update(sessionId, (current) => ({
+        ...current,
+        terminals: current.terminals.map((terminal) => terminal.id !== id ? terminal : typeof patch === 'function' ? patch(terminal) : { ...terminal, ...patch }),
+      }))
+    },
+    resetSandboxState() {
+      update(sessionId, (current) => ({
+        ...current,
+        terminals: current.terminals.map((terminal) => ({ ...terminal, cwdByTarget: { ...terminal.cwdByTarget, sandbox: '.' }, entries: [] })),
+      }))
+    },
+  }
+}
+
+export function clearTerminalWorkspaceForTests(sessionId?: string) {
+  if (sessionId) {
+    states.delete(sessionId)
+    emit(sessionId)
+    return
+  }
+  states.clear()
+}
