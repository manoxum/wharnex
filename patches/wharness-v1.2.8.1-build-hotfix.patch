 DIST_DIR ?= $(ROOT_DIR)/dist
 BACKEND_BIN := $(DIST_DIR)/bin/wharness-backend
+BUILD_STAMP := $(ROOT_DIR)/.harness/build-success
 
 .PHONY: help deps build build-backend build-frontend build-desktop build-runner \
