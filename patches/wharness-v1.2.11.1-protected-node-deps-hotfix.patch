+	if err != nil {
+		t.Fatalf("expected copied .bin symlink: %v", err)
+	}
+	resolved := filepath.Clean(filepath.Join(filepath.Dir(copiedLink), target))
+	data, err := os.ReadFile(resolved)
+	if err != nil {
+		t.Fatalf("copied dependency target is unusable: %v", err)
+	}
