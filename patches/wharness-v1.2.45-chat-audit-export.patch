+## v1.2.45 chat audit export
+
+- `services/backend/internal/app/chat_export_test.go` verifies that the audit ZIP preserves the exact original bytes for main request/response and correction request/response bundles, exports execution and approval events, and correlates ChatGPT transcript responses to their request ids.
+- `services/frontend/src/components/AgentWorkspace.test.tsx` verifies the Agent activity rail exposes the **Exportar chat** action and dispatches the export callback.
+- The HTTP export endpoint is bounded to a 32 MiB JSON description, writes the potentially large ZIP through a temporary file instead of buffering the whole archive in the HTTP handler, and fails the export when a persisted artifact listed by the session cannot be read.
+- In this source-only validation environment the Go gate cannot start because `github.com/jackc/pgx/v5` is absent from the module cache and outbound access to `proxy.golang.org` is blocked. The operator apply batch therefore runs the canonical backend/frontend gates after `git apply --check` in the real workspace.
+
 ## v1.2.43.2.5 retained-patches export rebase regression
 
 - Reproduced from the operator run: v1.2.43.2.4 fails at `git apply --check` on `scripts/export.sh:21`, so none of that patch is applied and the checkout remains on the working v1.2.43.2.3 exporter.
diff --git a/services/backend/internal/app/chat_export.go b/services/backend/internal/app/chat_export.go
new file mode 100644
index 0000000..5203611
--- /dev/null
+++ b/services/backend/internal/app/chat_export.go
@@ -0,0 +1,182 @@
+package app
+
+import (
+	"archive/zip"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"sort"
+	"strings"
+	"time"
+
+	"kernl.local/harness/backend/internal/domain"
+)
+
+const ChatExportSchema = "wharness.chat-export/v1"
+
+type ChatExportInput struct {
+	ChatID         string           `json:"chat_id"`
+	Title          string           `json:"title"`
+	ChatGPTURL     string           `json:"chatgpt_url,omitempty"`
+	ChatItems      []map[string]any `json:"chat_items"`
+	FrontendEvents []domain.Event   `json:"frontend_events"`
+}
+
+type ChatExportSummary struct {
+	Filename   string
+	Generated  time.Time
+	EntryCount int
+}
+
+type exportArtifact struct {
+	domain.ArtifactRecord
+	ExportPath string `json:"export_path"`
+	Lineage    string `json:"lineage"`
+}
+
+type gptExportResponse struct {
+	ItemID    string `json:"item_id,omitempty"`
+	RequestID string `json:"request_id,omitempty"`
+	CreatedAt string `json:"created_at,omitempty"`
+	TurnKind  string `json:"turn_kind,omitempty"`
+	Text      string `json:"text"`
+}
+
+func (s *Service) WriteChatExport(ctx context.Context, sessionID string, input ChatExportInput, dst io.Writer) (ChatExportSummary, error) {
+	item, err := s.store.Get(sessionID)
+	if err != nil {
+		return ChatExportSummary{}, err
+	}
+	if strings.TrimSpace(input.ChatID) == "" {
+		input.ChatID = item.ChatID
+	}
+	if item.ChatID != "" && input.ChatID != item.ChatID {
+		return ChatExportSummary{}, fmt.Errorf("chat export id %q does not match session chat %q", input.ChatID, item.ChatID)
+	}
+
+	generated := time.Now().UTC()
+	backendEvents := s.bus.History(sessionID)
+	artifactIndex := make([]exportArtifact, 0, len(item.Artifacts))
+	zw := zip.NewWriter(dst)
+	entries := 0
+	add := func(name string, raw []byte) error {
+		writer, createErr := zw.CreateHeader(&zip.FileHeader{Name: name, Method: zip.Deflate})
+		if createErr != nil {
+			return createErr
+		}
+		if _, writeErr := writer.Write(raw); writeErr != nil {
+			return writeErr
+		}
+		entries++
+		return nil
+	}
+	addJSON := func(name string, value any) error {
+		raw, marshalErr := json.MarshalIndent(value, "", "  ")
+		if marshalErr != nil {
+			return marshalErr
+		}
+		return add(name, append(raw, '\n'))
+	}
+
+	manifest := map[string]any{
+		"schema": ChatExportSchema, "generated_at": generated, "session_id": item.ID,
+		"chat_id": input.ChatID, "title": input.Title, "project_path": item.ProjectPath,
+		"backend_event_count": len(backendEvents), "frontend_event_count": len(input.FrontendEvents),
+		"chat_item_count": len(input.ChatItems), "artifact_count": len(item.Artifacts),
+	}
+	if input.ChatGPTURL != "" {
+		manifest["chatgpt_url"] = input.ChatGPTURL
+	}
+	if err := addJSON("manifest.json", manifest); err != nil {
+		return ChatExportSummary{}, err
+	}
+	if err := add("README.md", []byte(chatExportReadme)); err != nil {
+		return ChatExportSummary{}, err
+	}
+	if err := addJSON("chat/transcript.json", input.ChatItems); err != nil {
+		return ChatExportSummary{}, err
+	}
+	if err := add("chat/transcript.md", []byte(renderChatTranscript(input.Title, input.ChatItems))); err != nil {
+		return ChatExportSummary{}, err
+	}
+	if err := addJSON("chat/gpt-responses-by-request.json", extractGPTResponses(input.ChatItems)); err != nil {
+		return ChatExportSummary{}, err
+	}
+	if err := addJSON("session/session.json", item); err != nil {
+		return ChatExportSummary{}, err
+	}
+	if err := addJSON("events/backend-events.json", backendEvents); err != nil {
+		return ChatExportSummary{}, err
+	}
+	if err := addJSON("events/frontend-cached-events.json", input.FrontendEvents); err != nil {
+		return ChatExportSummary{}, err
+	}
+	if err := writeExecutionExport(addJSON, item, backendEvents); err != nil {
+		return ChatExportSummary{}, err
+	}
+	if err := addJSON("security/policy-and-permissions.json", map[string]any{
+		"current_policy": item.Policy, "events": securityEvents(backendEvents),
+	}); err != nil {
+		return ChatExportSummary{}, err
+	}
+	if err := addJSON("planner/request-lineages.json", item.RequestLineages); err != nil {
+		return ChatExportSummary{}, err
+	}
+	if item.Plan != nil {
+		if err := addJSON("planner/current-plan.json", item.Plan); err != nil {
+			return ChatExportSummary{}, err
+		}
+	}
+	if item.LastTurn != nil {
+		if err := addJSON("planner/last-turn.json", item.LastTurn); err != nil {
+			return ChatExportSummary{}, err
+		}
+	}
+	if item.LastManualPrompt != "" {
+		if err := add("planner/last-manual-prompt.md", []byte(item.LastManualPrompt+"\n")); err != nil {
+			return ChatExportSummary{}, err
+		}
+	}
+
+	artifacts := append([]domain.ArtifactRecord(nil), item.Artifacts...)
+	sort.Slice(artifacts, func(i, j int) bool { return artifacts[i].CreatedAt.Before(artifacts[j].CreatedAt) })
+	for _, record := range artifacts {
+		_, raw, readErr := s.ReadArtifact(ctx, sessionID, record.ID)
+		if readErr != nil {
+			return ChatExportSummary{}, fmt.Errorf("read artifact %s for chat export: %w", record.ID, readErr)
+		}
+		lineage := artifactLineage(item, record)
+		exportPath := artifactExportPath(record, lineage)
+		if err := add(exportPath, raw); err != nil {
+			return ChatExportSummary{}, err
+		}
+		artifactIndex = append(artifactIndex, exportArtifact{ArtifactRecord: record, ExportPath: exportPath, Lineage: lineage})
+	}
+	if err := addJSON("artifacts/index.json", artifactIndex); err != nil {
+		return ChatExportSummary{}, err
+	}
+	if err := zw.Close(); err != nil {
+		return ChatExportSummary{}, err
+	}
+	chat := safeExportSegment(input.ChatID)
+	if chat == "" {
+		chat = "unknown"
+	}
+	return ChatExportSummary{Filename: fmt.Sprintf("wharness-chat-%s-%s.zip", chat, generated.Format("20060102T150405Z")), Generated: generated, EntryCount: entries}, nil
+}
+
+func writeExecutionExport(addJSON func(string, any) error, item domain.Session, events []domain.Event) error {
+	if err := addJSON("execution/operational-events.json", executionEvents(events)); err != nil {
+		return err
+	}
+	if item.LastExecution != nil {
+		if err := addJSON("execution/last-execution.json", item.LastExecution); err != nil {
+			return err
+		}
+	}
+	if err := addJSON("execution/pending-host-changes.json", item.PendingHostChanges); err != nil {
+		return err
+	}
+	return addJSON("execution/last-applied-changes.json", item.LastAppliedChanges)
+}
diff --git a/services/backend/internal/app/chat_export_format.go b/services/backend/internal/app/chat_export_format.go
new file mode 100644
index 0000000..993b75e
--- /dev/null
+++ b/services/backend/internal/app/chat_export_format.go
@@ -0,0 +1,168 @@
+package app
+
+import (
+	"fmt"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	"kernl.local/harness/backend/internal/domain"
+)
+
+const chatExportReadme = `# Wharness chat audit export
+
+Schema: wharness.chat-export/v1
+
+This archive is a user-requested diagnostic export of one Harness chat. It contains:
+
+- the local transcript and GPT responses correlated to request ids when available;
+- backend operational events plus the frontend cached event history;
+- execution results with argv, stdout, stderr, exit codes, success and errors retained by Wharness;
+- Policy/approval/blocking events and the current Policy decision;
+- request lineage (main request, repair/correction, conflict/evidence derivatives);
+- every persisted chat artifact, including the original request/response ZIP bytes.
+
+Persisted artifact bytes are copied unchanged. Operational event fields keep the normal Wharness audit redaction rules. The export does not read ChatGPT cookies, browser storage, or unrelated conversations.
+`
+
+func renderChatTranscript(title string, items []map[string]any) string {
+	var out strings.Builder
+	out.WriteString("# ")
+	if strings.TrimSpace(title) == "" {
+		out.WriteString("Harness chat")
+	} else {
+		out.WriteString(title)
+	}
+	out.WriteString("\n\n")
+	for _, item := range items {
+		source := stringField(item, "source")
+		if source == "" {
+			source = stringField(item, "role")
+		}
+		label := map[string]string{"user": "User", "chatgpt": "ChatGPT", "wharness": "Wharness", "harness": "Wharness"}[source]
+		if label == "" {
+			label = source
+		}
+		requestID := requestIDFromItem(item)
+		out.WriteString("## ")
+		out.WriteString(label)
+		if created := stringField(item, "createdAt"); created != "" {
+			out.WriteString(" · ")
+			out.WriteString(created)
+		}
+		if requestID != "" {
+			out.WriteString(" · `")
+			out.WriteString(requestID)
+			out.WriteString("`")
+		}
+		out.WriteString("\n\n")
+		out.WriteString(stringField(item, "text"))
+		out.WriteString("\n\n")
+	}
+	return out.String()
+}
+
+func extractGPTResponses(items []map[string]any) []gptExportResponse {
+	responses := make([]gptExportResponse, 0)
+	lastRequestID := ""
+	for _, item := range items {
+		if requestID := requestIDFromItem(item); requestID != "" {
+			lastRequestID = requestID
+		}
+		if stringField(item, "source") != "chatgpt" {
+			continue
+		}
+		requestID := requestIDFromItem(item)
+		if requestID == "" {
+			requestID = lastRequestID
+		}
+		responses = append(responses, gptExportResponse{
+			ItemID: stringField(item, "id"), RequestID: requestID,
+			CreatedAt: stringField(item, "createdAt"), TurnKind: stringField(item, "turnKind"), Text: stringField(item, "text"),
+		})
+	}
+	return responses
+}
+
+func requestIDFromItem(item map[string]any) string {
+	iteration, ok := item["iteration"].(map[string]any)
+	if !ok {
+		return ""
+	}
+	if value, ok := iteration["requestId"].(string); ok {
+		return value
+	}
+	return ""
+}
+
+func stringField(item map[string]any, key string) string {
+	value, _ := item[key].(string)
+	return value
+}
+
+func executionEvents(events []domain.Event) []domain.Event {
+	selected := make([]domain.Event, 0)
+	for _, event := range events {
+		kind := strings.ToLower(event.Type)
+		if containsAny(kind, "execution.", "command.", "terminal.command_", "verification", "patch.", "host.apply", "apply.") {
+			selected = append(selected, event)
+		}
+	}
+	return selected
+}
+
+func securityEvents(events []domain.Event) []domain.Event {
+	selected := make([]domain.Event, 0)
+	for _, event := range events {
+		kind := strings.ToLower(event.Type)
+		if containsAny(kind, "policy", "approval", "approved", "blocked", "permission", "network", "mode_changed", "pending_rejected", "request.cancelled") {
+			selected = append(selected, event)
+		}
+	}
+	return selected
+}
+
+func containsAny(value string, needles ...string) bool {
+	for _, needle := range needles {
+		if strings.Contains(value, needle) {
+			return true
+		}
+	}
+	return false
+}
+
+func artifactLineage(item domain.Session, record domain.ArtifactRecord) string {
+	if lineage, ok := item.RequestLineages[record.RequestID]; ok && lineage.Kind != "" {
+		return lineage.Kind
+	}
+	return "standard"
+}
+
+func artifactExportPath(record domain.ArtifactRecord, lineage string) string {
+	name := safeExportSegment(record.ID) + "__" + safeExportSegment(filepath.Base(record.Name))
+	if record.Bundle {
+		phase := safeExportSegment(lineage)
+		switch phase {
+		case "standard", "":
+			phase = "main"
+		case "repair":
+			phase = "correction"
+		}
+		side := "request"
+		if record.Direction == "output" {
+			side = "response"
+		}
+		return fmt.Sprintf("bundles/%s/%s/%s", phase, side, name)
+	}
+	return fmt.Sprintf("artifacts/%s/%s/%s", safeExportSegment(record.Direction), safeExportSegment(record.Kind), name)
+}
+
+var unsafeExportSegment = regexp.MustCompile(`[^A-Za-z0-9._-]+`)
+
+func safeExportSegment(value string) string {
+	value = strings.Trim(unsafeExportSegment.ReplaceAllString(strings.TrimSpace(value), "_"), "._-")
+	if len(value) > 180 {
+		value = value[:180]
+	}
+	return value
+}
