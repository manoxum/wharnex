+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(ws.Path)
+	if _, err := os.Stat(filepath.Join(ws.Path, ".git")); err != nil {
+		t.Fatalf("sandbox .git missing: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(ws.Path, "hello.txt"), []byte("after\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
