+.editor-tab .dirty-dot { margin-left: 2px; }
+.editor-tabbar .editor-save { flex: 0 0 auto; margin: 5px 7px; border-color: #3b4037; background: #292d27; color: #c1c8b9; }
+.editor-tabbar .editor-save:hover:not(:disabled) { background: #343a31; }
+.editor-contextbar { height: 31px; flex: 0 0 31px; min-width: 0; padding: 0 10px 0 13px; display: flex; align-items: center; justify-content: space-between; gap: 10px; border-bottom: 1px solid #282c26; background: #181a17; color: #778071; }
+.editor-breadcrumbs { min-width: 0; display: flex; align-items: center; gap: 5px; overflow: hidden; white-space: nowrap; font: 9px ui-monospace, 'SFMono-Regular', Consolas, monospace; }
+.editor-breadcrumbs span { display: inline-flex; align-items: center; gap: 5px; }
+.editor-breadcrumbs i { color: #4f574b; font-style: normal; }
+.editor-shortcuts { flex: 0 0 auto; display: flex; gap: 10px; color: #596157; font: 8px ui-monospace, 'SFMono-Regular', Consolas, monospace; }
+.monaco-editor-host { flex: 1; min-width: 0; min-height: 0; background: #151713; }
+.editor-statusbar { height: 24px; flex: 0 0 24px; border-color: #30342d; background: #1e211c; color: #70786b; }
+.editor-statusbar > div { display: flex; align-items: center; gap: 12px; }
+.editor-statusbar > div span + span { position: relative; }
+.editor-statusbar > div span + span::before { content: '·'; position: absolute; left: -8px; color: #454b41; }
+.editor-empty { background: #151713; color: #687063; }
+.editor-empty .empty-mark { color: #30352d; }
+.editor-empty h3 { color: #a3ab9c; }
+.editor-empty p { color: #687063; }
+
+/* Explicit terminal target selection */
+.terminal-target-switch { height: 24px; display: inline-flex; align-items: center; padding: 2px; border: 1px solid #343931; border-radius: 6px; background: #11130f; }
+.terminal-target-switch button { height: 18px; padding: 0 7px; border: 0; border-radius: 4px; background: transparent; color: #697166; font: 8px ui-monospace, 'SFMono-Regular', Consolas, monospace; cursor: pointer; }
+.terminal-target-switch button.active { background: #30362c; color: #cfe0bb; }
+.terminal-target-switch button.host.active { background: #5a2a24; color: #ffd8d0; }
+.terminal-target-host { border-top-color: #6a3830; }
+.terminal-target-host > header { background: #201816; border-bottom-color: #4d2d28; }
+.terminal-host-warning { min-height: 30px; flex: 0 0 auto; padding: 5px 12px; display: flex; align-items: center; gap: 9px; border-bottom: 1px solid #503029; background: #2d1c19; color: #d7a59c; font-size: 9px; }
+.terminal-host-warning strong { color: #ffb3a5; font: 700 8px ui-monospace, 'SFMono-Regular', Consolas, monospace; letter-spacing: .08em; }
+.host-network-label { padding: 0 5px; color: #a77d74 !important; font-size: 8px !important; }
+.ide-terminal-entry.target-host .terminal-prompt span, .terminal-target-host .terminal-input-row > span { color: #e79583; }
+
+@media (max-width: 1180px) {
+  .editor-shortcuts span:nth-child(-n+2) { display: none; }
+}
