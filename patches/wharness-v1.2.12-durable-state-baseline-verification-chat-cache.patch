+func (s *Store) load() error {
+	if s.path == "" {
+		return nil
+	}
+	data, err := os.ReadFile(s.path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("read session state: %w", err)
+	}
+	var envelope persistenceEnvelope
+	if err := json.Unmarshal(data, &envelope); err != nil {
